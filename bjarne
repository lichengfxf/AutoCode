#!/bin/bash
# Bjarne - 自主 AI 开发系统
#
# 命令：
#   bjarne init [--safe]            - 从 idea.md 文件初始化项目
#   bjarne refresh <notes.md>       - 用一个自由格式笔记，添加任务到现有项目
#   bjarne task [opts] "desc"       - 运行项目中的一个单独的任务
#   bjarne [opts] [n]               - 运行 n 次迭代（默认 25 次）
#   bjarne --rebuild                - 强制重新构建 Docker 镜像（仅安全模式）
#   bjarne --update                 - 立即检查更新
#   bjarne --disable-auto-update    - 禁用自动更新检查
#   bjarne --enable-auto-update     - 重新启用自动更新检查
#
# 主循环选项：
#   --batch             - 启用批量模式（每次最多处理 5 个相关任务）
#   --batch=N, -bN      - 启用批量模式并指定自定义大小（最多 N 个任务）
#                         任务按自然关联性分组，而非强制分组
#
# task模式选项：
#   --safe              - 在 Docker 容器中运行
#   -f, --file <file>   - 从文件读取任务描述
#   --branch <name>     - 使用自定义分支名称
#   --no-pr             - 跳过 PR 创建
#   -n <num>            - 最大迭代次数（默认 25）
#
# 安全模式 (--safe)：在 Docker 容器中运行 Claude，该容器只能访问
# 项目目录。用于无人值守运行，以防止对系统上其他文件
# 造成意外损坏。
#
# 循环：规划 → 执行 → 评审 → 修复
#
# 任务模式：隔离的单任务修复。不会修改 CONTEXT.md、TASKS.md。
# 使用 .bjarne/tasks/<task-id>/ 存储状态。如果 git/gh 可用，会自动创建分支和 PR。
#
# idea.md/notes.md 是自由格式的 - 随意编写内容。Bjarne 会自动理解。
#
# 提示词目录（使用者无需关心）
#
# 所有 AI 自主开发相关提示词都存储在 prompts/ 目录中（相对于此脚本）。
# 这种分离使提示词可以独立于脚本逻辑进行编辑。
#
# 文件类型：
#   - *.md: 静态提示词（按原样加载）
#   - *.template: 需要变量替换的提示词
#
# 要添加或修改提示词：
#   1. 在 prompts/ 目录中编辑/创建文件
#   2. 静态内容使用 load_prompt()，模板使用 load_prompt_with_subst()
#   3. 详细文档请参阅 prompts/README.md
#

set -e

# 颜色
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
RED='\033[0;31m'
CYAN='\033[0;36m'
NC='\033[0m'

# 文件
TASK_FILE="TASKS.md"
CONTEXT_FILE="CONTEXT.md"
SPECS_DIR="specs"
TASK_STATE=".task"

# 重试设置
MAX_RETRIES=5
RETRY_DELAY=10

# 日志（使用绝对路径以在 worktree 切换后保持有效）
BJARNE_PROJECT_ROOT="$(pwd)"
LOG_DIR="$BJARNE_PROJECT_ROOT/.bjarne/logs"
LOG_FILE="$LOG_DIR/bjarne.log"

# 脚本目录和提示词位置（使用绝对路径以确保可靠性）
BJARNE_SCRIPT_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
PROMPTS_DIR="$BJARNE_SCRIPT_DIR/prompts"

# 自动更新设置
BJARNE_CONFIG_DIR="$HOME/.bjarne"
BJARNE_LAST_UPDATE_CHECK="$BJARNE_CONFIG_DIR/last_update_check"
BJARNE_UPDATE_DISABLED="$BJARNE_CONFIG_DIR/auto_update_disabled"
BJARNE_UPDATE_INTERVAL=$((2 * 24 * 60 * 60))  # 2 天（秒）
BJARNE_REMOTE_URL="https://raw.githubusercontent.com/lichengfxf/AutoCode/refs/heads/master/bjarne"

#==============================================================================
# 自动更新功能
#==============================================================================

# 检查更新（每 2 天运行一次，或如果传递了 --check-now 则立即检查）
check_for_updates() {
    local check_now="$1"  # 如果为 "true"，则跳过时间间隔检查

    # 如果自动更新已禁用，则跳过
    if [[ -f "$BJARNE_UPDATE_DISABLED" ]]; then
        return 0
    fi

    # 如果需要，创建配置目录
    mkdir -p "$BJARNE_CONFIG_DIR"

    local now=$(date +%s)

    # 检查是否需要检查（每 2 天），除非传递了 --check-now
    if [[ "$check_now" != "true" ]]; then
        if [[ -f "$BJARNE_LAST_UPDATE_CHECK" ]]; then
            local last_check=$(cat "$BJARNE_LAST_UPDATE_CHECK" 2>/dev/null || echo "0")
            if (( now - last_check < BJARNE_UPDATE_INTERVAL )); then
                return 0  # 还没到检查时间
            fi
        fi
    fi

    # 记录此次检查时间
    echo "$now" > "$BJARNE_LAST_UPDATE_CHECK"

    # 获取此脚本的路径
    local script_path
    script_path=$(realpath "$0" 2>/dev/null || readlink -f "$0" 2>/dev/null || echo "$0")

    # 获取远程脚本到临时文件
    local temp_remote=$(mktemp)
    if ! curl -fsSL "$BJARNE_REMOTE_URL" -o "$temp_remote" 2>/dev/null; then
        rm -f "$temp_remote"
        return 0  # 如果无法获取，静默失败
    fi

    # 比较哈希值
    local local_hash=$(sha256sum "$script_path" 2>/dev/null | cut -d' ' -f1)
    local remote_hash=$(sha256sum "$temp_remote" 2>/dev/null | cut -d' ' -f1)

    if [[ "$local_hash" == "$remote_hash" ]]; then
        rm -f "$temp_remote"
        return 0  # 已是最新版本
    fi

    # 有可用更新 - 询问用户
    echo -e "${CYAN}bjarne 有新版本可用。${NC}"
    echo -n "是否更新? [y/N] "
    read -r response

    if [[ ! "$response" =~ ^[Yy]$ ]]; then
        echo -e "${YELLOW}已跳过更新。${NC}"
        rm -f "$temp_remote"
        return 0
    fi

    # 执行更新
    echo -e "${CYAN}正在更新 bjarne...${NC}"

    # 检查是否需要 sudo
    if [[ -w "$script_path" ]]; then
        cp "$temp_remote" "$script_path"
        chmod +x "$script_path"
    else
        echo -e "${YELLOW}需要提升权限来更新 ${script_path}${NC}"
        if ! sudo cp "$temp_remote" "$script_path"; then
            echo -e "${RED}更新失败 - 无法写入 ${script_path}${NC}"
            rm -f "$temp_remote"
            return 1
        fi
        sudo chmod +x "$script_path"
    fi

    rm -f "$temp_remote"

    echo -e "${GREEN}bjarne 更新成功!${NC}"
    echo -e "${YELLOW}请重新运行命令: bjarne $*${NC}"
    exit 0
}

#==============================================================================
# 自动更新切换命令
#==============================================================================

if [[ "$1" == "--disable-auto-update" ]]; then
    mkdir -p "$BJARNE_CONFIG_DIR"
    touch "$BJARNE_UPDATE_DISABLED"
    echo -e "${GREEN}自动更新已禁用。${NC}"
    echo -e "要重新启用: bjarne --enable-auto-update"
    exit 0
fi

if [[ "$1" == "--enable-auto-update" ]]; then
    rm -f "$BJARNE_UPDATE_DISABLED"
    echo -e "${GREEN}自动更新已启用。${NC}"
    exit 0
fi

if [[ "$1" == "--update" ]]; then
    # 立即强制检查更新，忽略 2 天间隔
    echo -e "${CYAN}正在检查更新...${NC}"
    check_for_updates "true"
    exit 0
fi

#==============================================================================
# 运行更新检查（在处理命令之前）
#==============================================================================

# 传递原始参数，以便退出消息可以告诉用户重新运行什么
check_for_updates "$@"

# 确保日志目录存在
mkdir -p "$LOG_DIR"

# 实例专用的临时文件夹，用于详细命令输出
# 使用 PID + 时间戳以确保跨并发实例的唯一性
BJARNE_INSTANCE_ID="$$_$(date +%s)"
BJN_BJARNE_TMP_DIR="/tmp/bjarne-${BJARNE_INSTANCE_ID}"
export BJN_BJARNE_TMP_DIR
mkdir -p "$BJN_BJARNE_TMP_DIR"

# 临时文件夹清理函数
cleanup_temp() {
    if [[ -d "$BJN_BJARNE_TMP_DIR" ]]; then
        rm -rf "$BJN_BJARNE_TMP_DIR"
    fi
}

# 捕获信号以确保在退出时清理（正常、中断、终止）
trap cleanup_temp EXIT INT TERM

# 日志函数
log() {
    local level="$1"
    local msg="$2"
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    echo "[$timestamp] [$level] $msg" >> "$LOG_FILE"
}

# 带上下文的日志（用于故障）
log_failure() {
    local phase="$1"
    local attempt="$2"
    local exit_code="$3"
    local output="$4"
    local prompt_size="$5"
    local prompt="$6"

    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    local fail_file="$LOG_DIR/failure_${timestamp//[: -]/_}.log"

    {
        echo "=== BJARNE 故障日志 ==="
        echo "时间戳: $timestamp"
        echo "阶段: $phase"
        echo "尝试: $attempt/$MAX_RETRIES"
        echo "退出码: $exit_code"
        echo "提示词大小: $prompt_size 字节"
        echo "工作目录: $(pwd)"
        echo "安全模式: $SAFE_MODE"
        echo ""
        echo "=== CLAUDE 输出 ==="
        echo "$output"
        echo ""
        echo "=== 实际发送的 PROMPT ==="
        echo "$prompt"
        echo ""
        echo "=== 当前 .task 文件 (如果存在) ==="
        if [[ -f "$TASK_STATE" ]]; then
            cat "$TASK_STATE"
        else
            echo "(无 .task 文件)"
        fi
    } > "$fail_file"

    log "ERROR" "故障已记录到 $fail_file"
    echo -e "${YELLOW}  故障详情已保存到: $fail_file${NC}"
}

# 安全模式 (Docker) 设置
BJARNE_DIR=".bjarne"
DOCKERFILE="$BJARNE_DIR/Dockerfile"
SAFE_MODE=false
IMAGE_NAME=""

#==============================================================================
# 提示词 - 早期定义，以便任务模式和主循环都可以使用它们
#==============================================================================
#
# prompts/ 目录包含 bjarne 使用的所有 AI 提示词模板。
#
# 目录结构：
#   prompts/
#   ├── plan.md              - 主规划阶段提示词
#   ├── execute.md           - 代码执行阶段提示词
#   ├── review.md            - 评审和验证提示词
#   ├── fix.md               - 错误修复提示词
#   ├── init.md              - 项目初始化提示词
#   ├── refresh.md           - 上下文刷新提示词
#   ├── decompose.md         - 任务分解提示词
#   ├── finalize-worktree.md - 支持 git worktree 的最终化
#   ├── finalize.md          - 标准最终化提示词
#   ├── batch-plan.md.template     - 批量模式规划（需要 $BJN_BJN_BATCH_SIZE）
#   ├── batch-execute.md           - 批量模式执行
#   ├── batch-review.md            - 批量模式评审
#   ├── batch-fix.md               - 批量模式修复
#   ├── dockerfile.template        - Dockerfile 生成（需要 $BJN_base_image）
#   └── verbose-rules.template     - 详细输出规则（需要 $BJN_BJARNE_TMP_DIR）
#
# 文件命名约定：
#   - *.md 文件：按原样加载的静态提示词
#   - *.template 文件：需要变量替换的提示词（使用 load_prompt_with_subst）
#
# 使用指南：
#   - 静态 *.md 文件使用 load_prompt()
#   - *.template 文件或需要变量替换时使用 load_prompt_with_subst()
#   - 为安全起见，始终仅指定您要替换的变量
#
# 添加新提示词：
#   1. 在 prompts/ 目录中创建文件
#   2. 静态内容使用 .md 扩展名，包含变量的内容使用 .template
#   3. 适当使用 load_prompt() 或 load_prompt_with_subst() 加载
#   4. 模板中的变量应使用 $VAR_NAME 格式并记录在文档中
#   5. export $VAR_NAME
#

# 从文件加载提示词内容，支持相对路径和绝对路径
# 用法：load_prompt <prompt_file>
# 参数：
#   prompt_file：可以是相对路径（例如 "plan.md"）或绝对路径（例如 "/full/path/to/plan.md"）
# 返回：成功时返回 0，文件未找到时返回 1
# 注意：相对路径相对于 $PROMPTS_DIR 解析
load_prompt() {
    local prompt_file="$1"
    local full_path

    # 确定路径是绝对路径还是相对路径
    if [[ "$prompt_file" = /* ]]; then
        # 绝对路径 - 按原样使用
        full_path="$prompt_file"
    else
        # 相对路径 - 相对于 PROMPTS_DIR 解析
        full_path="$PROMPTS_DIR/$prompt_file"
    fi

    # 验证文件是否存在
    if [[ ! -f "$full_path" ]]; then
        log "ERROR" "未找到提示词文件: $full_path"
        return 1
    fi

    cat "$full_path"
}

# 从模板文件加载提示词内容并执行变量替换
# 用法：load_prompt_with_subst <template_file> [variables_to_substitute]
# 参数：
#   template_file：可以是相对路径（例如 "dockerfile.template"）或绝对路径
#   variables_to_substitute：要替换的变量可选列表（例如 "$BJN_base_image"）
# 返回：成功时返回 0，文件未找到时返回 1
# 示例：
#   load_prompt_with_subst "dockerfile.template"              # 替换所有环境变量
#   load_prompt_with_subst "dockerfile.template" '$BJN_base_image' # 仅替换 $BJN_base_image
# 注意：相对路径相对于 $PROMPTS_DIR 解析
load_prompt_with_subst() {
    local template_file="$1"
    local full_path

    # 确定路径是绝对路径还是相对路径
    if [[ "$template_file" = /* ]]; then
        # 绝对路径 - 按原样使用
        full_path="$template_file"
    else
        # 相对路径 - 相对于 PROMPTS_DIR 解析
        full_path="$PROMPTS_DIR/$template_file"
    fi

    # 验证文件是否存在
    if [[ ! -f "$full_path" ]]; then
        log "ERROR" "未找到模板文件: $full_path"
        return 1
    fi

    shift  # 从参数中删除文件名
    local vars="$*"  # 获取变量列表（可选）

    # 使用envsubst命令解析变量，因为是独立的命令，变量必须export
    if [[ -n "$vars" ]]; then
        # 仅替换指定的变量
        envsubst "$vars" < "$full_path"
    else
        # 替换所有环境变量
        envsubst < "$full_path"
    fi
}

PLAN_PROMPT=$(load_prompt "plan.md")
EXECUTE_PROMPT=$(load_prompt "execute.md")

REVIEW_PROMPT=$(load_prompt "review.md")
FIX_PROMPT=$(load_prompt "fix.md")

#==============================================================================
# 针对输出数据很多的命令创建的规则 - 注入到所有提示词中以节省 tokens
#==============================================================================

# 使用当前临时文件夹路径生成详细输出规则
get_verbose_output_rules() {
    load_prompt_with_subst "verbose-rules.template"
}

#==============================================================================
# 安全模式功能
#==============================================================================

# 检测项目是否使用安全模式
detect_safe_mode() {
    if [[ -f "$DOCKERFILE" ]]; then
        # 检查 Docker 是否可用
        if ! command -v docker &>/dev/null; then
            echo -e "${RED}错误: 安全模式需要 Docker 但未找到${NC}"
            exit 1
        fi

        # 检查凭证是否存在
        if [[ ! -f "$HOME/.claude/.credentials.json" ]]; then
            echo -e "${RED}错误: 在 ~/.claude/.credentials.json 未找到 Claude 凭证${NC}"
            echo -e "请先在主机上运行 'claude' 进行认证"
            exit 1
        fi

        SAFE_MODE=true
        # 从当前目录生成镜像名称
        PROJECT_NAME=$(basename "$(pwd)" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9-]/-/g')
        IMAGE_NAME="bjarne-${PROJECT_NAME}"
    fi
}

# 如果需要，构建 Docker 镜像
build_docker_image() {
    local force_rebuild="$1"

    if [[ "$force_rebuild" == "true" ]] || ! docker image inspect "$IMAGE_NAME" &>/dev/null 2>&1; then
        echo -e "${CYAN}正在构建 Docker 镜像: $IMAGE_NAME${NC}"
        docker build -t "$IMAGE_NAME" -f "$DOCKERFILE" . || {
            echo -e "${RED}Docker 构建失败${NC}"
            exit 1
        }
        echo -e "${GREEN}镜像构建成功${NC}"
    else
        echo -e "${CYAN}使用缓存的镜像: $IMAGE_NAME${NC}"
    fi
}

# 为检测到的技术栈获取合适的 Docker 基础镜像
get_BJN_base_image() {
    if [[ -f "package.json" ]]; then
        echo "node:22-bookworm"
    elif [[ -f "requirements.txt" ]] || [[ -f "pyproject.toml" ]]; then
        echo "python:3.12-bookworm"
    elif [[ -f "Cargo.toml" ]]; then
        echo "rust:1-bookworm"
    elif [[ -f "go.mod" ]]; then
        echo "golang:1.23-bookworm"
    elif [[ -f "composer.json" ]]; then
        echo "php:8.4-cli-bookworm"
    elif [[ -f "pubspec.yaml" ]]; then
        echo "dart:stable"
    else
        # 默认使用 Node，因为它包含 Claude Code 所需的 npm
        echo "node:22-bookworm"
    fi
}

# 获取技术特定依赖的卷挂载
get_dep_volume() {
    local project_name="$1"

    if [[ -f "package.json" ]]; then
        echo "${project_name}-node-modules:/workspace/node_modules"
    elif [[ -f "requirements.txt" ]] || [[ -f "pyproject.toml" ]]; then
        echo "${project_name}-venv:/workspace/.venv"
    elif [[ -f "Cargo.toml" ]]; then
        echo "${project_name}-target:/workspace/target"
    elif [[ -f "go.mod" ]]; then
        echo "${project_name}-gopath:/go"
    elif [[ -f "composer.json" ]]; then
        echo "${project_name}-vendor:/workspace/vendor"
    else
        echo ""
    fi
}

# 为安全模式生成 Dockerfile
generate_dockerfile() {
    local BJN_base_image=$(get_BJN_base_image)

    mkdir -p "$BJARNE_DIR"

    load_prompt_with_subst "dockerfile.template" > "$DOCKERFILE"

    echo -e "  - 已生成 $DOCKERFILE (基础镜像: $BJN_base_image)"
}

#==============================================================================
# Git/GH 检测功能（用于 task 命令）
#==============================================================================

# 检测 git 是否可用以及我们是否在仓库中
detect_git() {
    if command -v git &>/dev/null && git rev-parse --git-dir &>/dev/null 2>&1; then
        echo "1"
    else
        echo "0"
    fi
}

# 检测 gh CLI 是否可用并已认证
detect_gh() {
    if command -v gh &>/dev/null && gh auth status &>/dev/null 2>&1; then
        echo "1"
    else
        echo "0"
    fi
}

# 从描述生成任务 ID（仅使用第一行作为 slug）
generate_task_id() {
    local description="$1"
    local timestamp=$(date +%s)
    # 仅使用第一个非空行作为 slug（处理多行 markdown）
    local first_line=$(echo "$description" | grep -v '^#' | grep -v '^$' | head -1)
    local slug=$(echo "$first_line" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g' | sed 's/--*/-/g' | cut -c1-30)
    echo "${timestamp}-${slug}"
}

# 使用重试逻辑运行 claude（支持安全模式）
# 用法：run_claude "prompt" "PHASE_NAME"
run_claude() {
    local user_prompt="$1"
    local phase="${2:-UNKNOWN}"
    local attempt=1
    local exit_code=0
    local claude_log_file=""
    local output=""

    # 将详细输出规则附加到所有提示词（在末尾 = 更显眼）
    local prompt="$user_prompt"
    local prompt_size=${#prompt}

    log "INFO" "启动 $phase 阶段（提示词：$prompt_size 字节）"

    while [[ $attempt -le $MAX_RETRIES ]]; do
        # 为此次尝试生成 claude 输出日志文件
        local timestamp=$(date '+%Y%m%d_%H%M%S')
        claude_log_file="$LOG_DIR/claude_${phase,,}_${timestamp}_attempt${attempt}.log"

        # 写入日志头部
        {
            echo "=============================================================================="
            echo "CLAUDE 输入/输出日志"
            echo "=============================================================================="
            echo "时间戳: $(date '+%Y-%m-%d %H:%M:%S')"
            echo "阶段: $phase"
            echo "尝试: $attempt/$MAX_RETRIES"
            echo "提示词大小: $prompt_size 字节"
            echo ""
            echo "------------------------------------------------------------------------------"
            echo "发送给Claude的 PROMPT (总共 $prompt_size 字节） :"
            echo "------------------------------------------------------------------------------"
            echo "$prompt"
            echo ""
            echo "------------------------------------------------------------------------------"
            echo "CLAUDE 输出:"
            echo "------------------------------------------------------------------------------"
        } > "$claude_log_file"

        # 使用 tee 运行 claude，实时输出到屏幕和文件
        if [[ "$SAFE_MODE" == true ]]; then
            # 在 Docker 容器中运行（作为 'bjarne' 用户，而非 root）
            local docker_args="-v $(pwd):/workspace"
            docker_args+=" -v $HOME/.claude/.credentials.json:/home/bjarne/.claude/.credentials.json:ro"

            # 如果可用，添加 gh CLI 配置（用于任务模式中的 PR 创建）
            if [[ -d "$HOME/.config/gh" ]]; then
                docker_args+=" -v $HOME/.config/gh:/home/bjarne/.config/gh:ro"
            fi

            # 如果可用，添加 gitconfig（用于提交）
            if [[ -f "$HOME/.gitconfig" ]]; then
                docker_args+=" -v $HOME/.gitconfig:/home/bjarne/.gitconfig:ro"
            fi

            # 如果适用，添加依赖卷
            local dep_volume=$(get_dep_volume "$PROJECT_NAME")
            if [[ -n "$dep_volume" ]]; then
                docker_args+=" -v $dep_volume"
            fi

            # 挂载临时文件夹用于详细输出日志（容器内路径相同）
            docker_args+=" -v $BJN_BJARNE_TMP_DIR:$BJN_BJARNE_TMP_DIR"

            # 使用 tee 运行，实时输出到屏幕和文件
            docker run --rm --user "$(id -u):$(id -g)" -e HOME=/home/bjarne \
                $docker_args -w /workspace "$IMAGE_NAME" \
                claude -p --dangerously-skip-permissions "$prompt" 2>&1 | tee -a "$claude_log_file"
            # 从管道获取退出码（使用 PIPESTATUS）
            exit_code=${PIPESTATUS[0]}
        else
            # 在主机上使用 tee 运行，实时输出
            claude -p --dangerously-skip-permissions "$prompt" 2>&1 | tee -a "$claude_log_file"
            # 从管道获取退出码
            exit_code=${PIPESTATUS[0]}
        fi

        # 写入日志尾部
        {
            echo ""
            echo "------------------------------------------------------------------------------"
            echo "退出码: $exit_code"
            echo "=============================================================================="
        } >> "$claude_log_file"

        # 显示日志文件位置
        if [[ $exit_code -eq 0 ]]; then
            echo -e "${CYAN}  [日志] $claude_log_file${NC}"
            log "INFO" "$phase 阶段完成->成功 (日志: $claude_log_file)"
            return 0
        fi

        # 检查特定的流式错误
        output=$(tail -100 "$claude_log_file")
        if echo "$output" | grep -q "only prompt commands are supported in streaming mode"; then
            log "ERROR" "$phase: 收到流式模式错误 (第 $attempt 次尝试)"
            echo -e "${YELLOW}  Claude 失败 (第 $attempt/$MAX_RETRIES 次尝试, 退出码: $exit_code)${NC}"
            echo -e "${RED}  错误: '仅支持流式模式下的提示命令'${NC}"
        else
            echo -e "${YELLOW}  Claude 失败 (第 $attempt/$MAX_RETRIES 次尝试, 退出码: $exit_code)${NC}"
        fi

        echo -e "${CYAN}  [日志] $claude_log_file${NC}"

        # 记录故障详情，包括实际提示词
        log_failure "$phase" "$attempt" "$exit_code" "$output" "$prompt_size" "$prompt"

        if [[ $attempt -lt $MAX_RETRIES ]]; then
            echo -e "${YELLOW}  ${RETRY_DELAY}s 后重试...${NC}"
            sleep $RETRY_DELAY
        fi

        ((attempt++))
    done

    echo -e "${RED}  已达最大重试次数 ($MAX_RETRIES 次)${NC}"
    log "ERROR" "$phase 阶段在 $MAX_RETRIES 次尝试后失败"
    echo -e "${YELLOW}  查看详细日志: $LOG_DIR/claude_${phase,,}_*.log${NC}"
    return 1
}

#==============================================================================
# INIT 命令 - 从想法文件引导项目（适用于新项目或现有项目）
