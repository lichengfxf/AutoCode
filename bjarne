    if [[ "$EXISTING_PROJECT" == "true" ]]; then
        EXISTING_CODE_INFO="
## 现有源文件（探索这些以了解已构建的内容）:
$SRC_FILES

这是一个现有项目。你必须：
1. 探索并理解现有代码库结构
2. 阅读关键文件以了解已实现的内容
3. 在 CONTEXT.md 中记录现有功能
4. 创建在现有代码基础上构建的任务，而不是重复它
"
    fi

    INIT_PROMPT=$(load_prompt "init.md")

    IDEA_CONTENT=$(cat "$IDEA_FILE")

    # Read CLAUDE.md if exists
    CLAUDE_MD=""
    if [[ -f "CLAUDE.md" ]]; then
        CLAUDE_MD="

## 现有的 CLAUDE.md (需要遵守的项目规则):
$(cat CLAUDE.md)
"
    fi

    run_claude "# 想法文件内容:

$IDEA_CONTENT

---

## 检测到的环境:
$DETECTED
$EXISTING_CODE_INFO
$CLAUDE_MD
---

$INIT_PROMPT" "INIT"

    # Verify files were created
    if [[ -f "$CONTEXT_FILE" ]] && [[ -f "$TASK_FILE" ]]; then
