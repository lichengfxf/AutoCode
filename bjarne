#!/bin/bash
# Bjarne - 自主 AI 开发系统
#
# 命令：
#   bjarne init                   - 从 idea.md 文件初始化项目
#   bjarne refresh <notes.md>     - 用一个自由格式笔记，添加任务到现有项目
#   bjarne [opts] [n]             - 运行 n 次迭代（默认 25 次）
#   bjarne --update              - 立即检查更新
#   bjarne --disable-auto-update - 禁用自动更新检查
#   bjarne --enable-auto-update  - 重新启用自动更新检查
#
# 主循环选项：
#   -p <phase>          - 从指定阶段开始 (plan|exec|review|fix)
#                         用于任务中断后恢复，避免从头开始
#
# 循环：规划 → 执行 → 评审 → 修复
#
# idea.md/notes.md 是自由格式的 - 随意编写内容。Bjarne 会自动理解。
#
# 提示词目录（使用者无需关心）
#
# 所有 AI 自主开发相关提示词都存储在 prompts/ 目录中（相对于此脚本）。
# 这种分离使提示词可以独立于脚本逻辑进行编辑。
#
# 文件类型：
#   - *.md: 静态提示词（按原样加载）
#   - *.template: 需要变量替换的提示词
#
# 要添加或修改提示词：
#   1. 在 prompts/ 目录中编辑/创建文件
#   2. 静态内容使用 load_prompt()，模板使用 load_prompt_with_subst()
#   3. 详细文档请参阅 prompts/README.md
#

set -e

# 颜色
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
RED='\033[0;31m'
CYAN='\033[0;36m'
NC='\033[0m'

# 文件
TASK_FILE="TASKS.md"
CONTEXT_FILE="CONTEXT.md"
SPECS_DIR="specs"
TASK_STATE="bjn_task.plan"
TASK_STATE_PLAN="bjn_task.plan"
TASK_STATE_REVIEW="bjn_task.review"

# 重试设置
MAX_RETRIES=5
RETRY_DELAY=10

# 日志（使用绝对路径以在 worktree 切换后保持有效）
BJARNE_PROJECT_ROOT="$(pwd)"
LOG_DIR="$BJARNE_PROJECT_ROOT/.bjarne/logs"
LOG_FILE="$LOG_DIR/bjarne.log"

# 脚本目录和提示词位置（使用绝对路径以确保可靠性）
BJARNE_SCRIPT_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
PROMPTS_DIR="$BJARNE_SCRIPT_DIR/prompts"

# 自动更新设置
BJARNE_CONFIG_DIR="$HOME/.bjarne"
BJARNE_LAST_UPDATE_CHECK="$BJARNE_CONFIG_DIR/last_update_check"
BJARNE_UPDATE_DISABLED="$BJARNE_CONFIG_DIR/auto_update_disabled"
BJARNE_UPDATE_INTERVAL=$((2 * 24 * 60 * 60))  # 2 天（秒）
BJARNE_REMOTE_URL="https://raw.githubusercontent.com/lichengfxf/AutoCode/refs/heads/master/bjarne"

#==============================================================================
# 自动更新功能
#==============================================================================

# 检查更新（每 2 天运行一次，或如果传递了 --check-now 则立即检查）
check_for_updates() {
    local check_now="$1"  # 如果为 "true"，则跳过时间间隔检查

    # 如果自动更新已禁用，则跳过
    if [[ -f "$BJARNE_UPDATE_DISABLED" ]]; then
        return 0
    fi

    # 如果需要，创建配置目录
    mkdir -p "$BJARNE_CONFIG_DIR"

    local now=$(date +%s)

    # 检查是否需要检查（每 2 天），除非传递了 --check-now
    if [[ "$check_now" != "true" ]]; then
        if [[ -f "$BJARNE_LAST_UPDATE_CHECK" ]]; then
            local last_check=$(cat "$BJARNE_LAST_UPDATE_CHECK" 2>/dev/null || echo "0")
            if (( now - last_check < BJARNE_UPDATE_INTERVAL )); then
                return 0  # 还没到检查时间
            fi
        fi
    fi

    # 记录此次检查时间
    echo "$now" > "$BJARNE_LAST_UPDATE_CHECK"

    # 获取此脚本的路径
    local script_path
    script_path=$(realpath "$0" 2>/dev/null || readlink -f "$0" 2>/dev/null || echo "$0")

    # 获取远程脚本到临时文件
    local temp_remote=$(mktemp)
    if ! curl -fsSL "$BJARNE_REMOTE_URL" -o "$temp_remote" 2>/dev/null; then
        rm -f "$temp_remote"
        return 0  # 如果无法获取，静默失败
    fi

    # 比较哈希值
    local local_hash=$(sha256sum "$script_path" 2>/dev/null | cut -d' ' -f1)
    local remote_hash=$(sha256sum "$temp_remote" 2>/dev/null | cut -d' ' -f1)

    if [[ "$local_hash" == "$remote_hash" ]]; then
        rm -f "$temp_remote"
        return 0  # 已是最新版本
    fi

    # 有可用更新 - 询问用户
    echo -e "${CYAN}bjarne 有新版本可用。${NC}"
    echo -n "是否更新? [y/N] "
    read -r response

    if [[ ! "$response" =~ ^[Yy]$ ]]; then
        echo -e "${YELLOW}已跳过更新。${NC}"
        rm -f "$temp_remote"
        return 0
    fi

    # 执行更新
    echo -e "${CYAN}正在更新 bjarne...${NC}"

    # 检查是否需要 sudo
    if [[ -w "$script_path" ]]; then
        cp "$temp_remote" "$script_path"
        chmod +x "$script_path"
    else
        echo -e "${YELLOW}需要提升权限来更新 ${script_path}${NC}"
        if ! sudo cp "$temp_remote" "$script_path"; then
            echo -e "${RED}更新失败 - 无法写入 ${script_path}${NC}"
            rm -f "$temp_remote"
            return 1
        fi
        sudo chmod +x "$script_path"
    fi

    rm -f "$temp_remote"

    echo -e "${GREEN}bjarne 更新成功!${NC}"
    echo -e "${YELLOW}请重新运行命令: bjarne $*${NC}"
    exit 0
}

#==============================================================================
# 自动更新切换命令
#==============================================================================

if [[ "$1" == "--disable-auto-update" ]]; then
    mkdir -p "$BJARNE_CONFIG_DIR"
    touch "$BJARNE_UPDATE_DISABLED"
    echo -e "${GREEN}自动更新已禁用。${NC}"
    echo -e "要重新启用: bjarne --enable-auto-update"
    exit 0
fi

if [[ "$1" == "--enable-auto-update" ]]; then
    rm -f "$BJARNE_UPDATE_DISABLED"
    echo -e "${GREEN}自动更新已启用。${NC}"
    exit 0
fi

if [[ "$1" == "--update" ]]; then
    # 立即强制检查更新，忽略 2 天间隔
    echo -e "${CYAN}正在检查更新...${NC}"
    check_for_updates "true"
    exit 0
fi

#==============================================================================
# 运行更新检查（在处理命令之前）
#==============================================================================

# 传递原始参数，以便退出消息可以告诉用户重新运行什么
check_for_updates "$@"

# 确保日志目录存在
mkdir -p "$LOG_DIR"

# 实例专用的临时文件夹，用于详细命令输出
# 使用 PID + 时间戳以确保跨并发实例的唯一性
BJARNE_INSTANCE_ID="$$_$(date +%s)"
BJN_BJARNE_TMP_DIR="/tmp/bjarne-${BJARNE_INSTANCE_ID}"
export BJN_BJARNE_TMP_DIR
mkdir -p "$BJN_BJARNE_TMP_DIR"

# 临时文件夹清理函数
cleanup_temp() {
    if [[ -d "$BJN_BJARNE_TMP_DIR" ]]; then
        rm -rf "$BJN_BJARNE_TMP_DIR"
    fi
}

# 捕获信号以确保在退出时清理（正常、中断、终止）
trap cleanup_temp EXIT INT TERM

# 日志函数
log() {
    local level="$1"
    local msg="$2"
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    echo "[$timestamp] [$level] $msg" >> "$LOG_FILE"
}

# 带上下文的日志（用于故障）
log_failure() {
    local phase="$1"
    local attempt="$2"
    local exit_code="$3"
    local output="$4"
    local prompt_size="$5"
    local prompt="$6"

    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    local fail_file="$LOG_DIR/failure_${timestamp//[: -]/_}.log"

    {
        echo "=== BJARNE 故障日志 ==="
        echo "时间戳: $timestamp"
        echo "阶段: $phase"
        echo "尝试: $attempt/$MAX_RETRIES"
        echo "退出码: $exit_code"
        echo "提示词大小: $prompt_size 字节"
        echo "工作目录: $(pwd)"
        echo ""
        echo "=== CLAUDE 输出 ==="
        echo "$output"
        echo ""
        echo "=== 实际发送的 PROMPT ==="
        echo "$prompt"
        echo ""
        echo "=== 当前 .task 文件 (如果存在) ==="
        if [[ -f "$TASK_STATE" ]]; then
            cat "$TASK_STATE"
        else
            echo "(无 .task 文件)"
        fi
    } > "$fail_file"

    log "ERROR" "故障已记录到 $fail_file"
    echo -e "${YELLOW}  故障详情已保存到: $fail_file${NC}"
}
#==============================================================================
# 提示词 - 早期定义，以便任务模式和主循环都可以使用它们
#==============================================================================
#
# prompts/ 目录包含 bjarne 使用的所有 AI 提示词模板。
#
# 目录结构：
#   prompts/
#   ├── plan.md              - 主规划阶段提示词
#   ├── execute.md           - 代码执行阶段提示词
#   ├── review.md            - 评审和验证提示词
#   ├── fix.md               - 错误修复提示词
#   ├── init.md              - 项目初始化提示词
#   ├── refresh.md           - 上下文刷新提示词
#   ├── decompose.md         - 任务分解提示词
#   ├── finalize-worktree.md - 支持 git worktree 的最终化
#   ├── finalize.md          - 标准最终化提示词
#   └── verbose-rules.template     - 详细输出规则（需要 $BJN_BJARNE_TMP_DIR）
#
# 文件命名约定：
#   - *.md 文件：按原样加载的静态提示词
#   - *.template 文件：需要变量替换的提示词（使用 load_prompt_with_subst）
#
# 使用指南：
#   - 静态 *.md 文件使用 load_prompt()
#   - *.template 文件或需要变量替换时使用 load_prompt_with_subst()
#   - 为安全起见，始终仅指定您要替换的变量
#
# 添加新提示词：
#   1. 在 prompts/ 目录中创建文件
#   2. 静态内容使用 .md 扩展名，包含变量的内容使用 .template
#   3. 适当使用 load_prompt() 或 load_prompt_with_subst() 加载
#   4. 模板中的变量应使用 $VAR_NAME 格式并记录在文档中
#   5. export $VAR_NAME
#

# 从文件加载提示词内容，支持相对路径和绝对路径
# 用法：load_prompt <prompt_file>
# 参数：
#   prompt_file：可以是相对路径（例如 "plan.md"）或绝对路径（例如 "/full/path/to/plan.md"）
# 返回：成功时返回 0，文件未找到时返回 1
# 注意：相对路径相对于 $PROMPTS_DIR 解析
load_prompt() {
    local prompt_file="$1"
    local full_path

    # 确定路径是绝对路径还是相对路径
    if [[ "$prompt_file" = /* ]]; then
        # 绝对路径 - 按原样使用
        full_path="$prompt_file"
    else
        # 相对路径 - 相对于 PROMPTS_DIR 解析
        full_path="$PROMPTS_DIR/$prompt_file"
    fi

    # 验证文件是否存在
    if [[ ! -f "$full_path" ]]; then
        log "ERROR" "未找到提示词文件: $full_path"
        return 1
    fi

    cat "$full_path"
}

# 从模板文件加载提示词内容并执行变量替换
# 用法：load_prompt_with_subst <template_file> [variables_to_substitute]
# 参数：
#   template_file：可以是相对路径（例如 "dockerfile.template"）或绝对路径
#   variables_to_substitute：要替换的变量可选列表（例如 "$BJN_base_image"）
# 返回：成功时返回 0，文件未找到时返回 1
# 示例：
#   load_prompt_with_subst "verbose-rules.template"              # 替换所有环境变量
#   load_prompt_with_subst "verbose-rules.template" '$BJN_BJARNE_TMP_DIR' # 仅替换指定变量
# 注意：相对路径相对于 $PROMPTS_DIR 解析
load_prompt_with_subst() {
    local template_file="$1"
    local full_path

    # 确定路径是绝对路径还是相对路径
    if [[ "$template_file" = /* ]]; then
        # 绝对路径 - 按原样使用
        full_path="$template_file"
    else
        # 相对路径 - 相对于 PROMPTS_DIR 解析
        full_path="$PROMPTS_DIR/$template_file"
    fi

    # 验证文件是否存在
    if [[ ! -f "$full_path" ]]; then
        log "ERROR" "未找到模板文件: $full_path"
        return 1
    fi

    shift  # 从参数中删除文件名
    local vars="$*"  # 获取变量列表（可选）

    # 使用envsubst命令解析变量，因为是独立的命令，变量必须export
    if [[ -n "$vars" ]]; then
        # 仅替换指定的变量
        envsubst "$vars" < "$full_path"
    else
        # 替换所有环境变量
        envsubst < "$full_path"
    fi
}

PLAN_PROMPT=$(load_prompt "plan.md")
EXECUTE_PROMPT=$(load_prompt "execute.md")

REVIEW_PROMPT=$(load_prompt "review.md")
FIX_PROMPT=$(load_prompt "fix.md")

#==============================================================================
# 针对输出数据很多的命令创建的规则 - 注入到所有提示词中以节省 tokens
#==============================================================================

# 使用当前临时文件夹路径生成详细输出规则
get_verbose_output_rules() {
    load_prompt_with_subst "verbose-rules.template"
}

#==============================================================================
# Git/GH 检测功能
#==============================================================================

# 检测 git 是否可用以及我们是否在仓库中
detect_git() {
    if command -v git &>/dev/null && git rev-parse --git-dir &>/dev/null 2>&1; then
        echo "1"
    else
        echo "0"
    fi
}

# 检测 gh CLI 是否可用并已认证
detect_gh() {
    if command -v gh &>/dev/null && gh auth status &>/dev/null 2>&1; then
        echo "1"
    else
        echo "0"
    fi
}

# 从描述生成任务 ID（仅使用第一行作为 slug）
generate_task_id() {
    local description="$1"
    local timestamp=$(date +%s)
    # 仅使用第一个非空行作为 slug（处理多行 markdown）
    local first_line=$(echo "$description" | grep -v '^#' | grep -v '^$' | head -1)
    local slug=$(echo "$first_line" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g' | sed 's/--*/-/g' | cut -c1-30)
    echo "${timestamp}-${slug}"
}

# 检测 jq 是否可用
HAS_JQ=0
if command -v jq &>/dev/null; then
    HAS_JQ=1
fi

# 处理 JSON 流输出，提取并格式化内容
process_json_stream() {
    while IFS= read -r line; do
        if [[ -n "$line" ]]; then
            if [[ "$HAS_JQ" == "1" ]]; then
                # 提取 message.content 数组中的数据
                echo "$line" | jq -r '
                    if .message and .message.content then
                        .message.content[] |
                            if .type == "text" then
                                .text
                            elif .type == "tool_use" then
                                if .name == "Bash" then
                                    "\n>>> [Bash] \(.input.command // "")"
                                elif .name == "Read" then
                                    "\n>>> [Read] \(.input.file_path // "")"
                                elif .name == "Write" or .name == "Edit" then
                                    "\n>>> [\(.name)] \(.input.file_path // "")"
                                else
                                    "\n>>> [\(.name)]"
                                end
                            elif .type == "tool_result" then
                                if .content and (.content | type) == "string" then
                                    .content
                                elif .content and (.content | type) == "object" and .content.text then
                                    .content.text
                                else
                                    empty
                                end
                            else
                                empty
                            end
                    else
                        empty
                    end
                ' 2>/dev/null
            else
                echo "$line"
            fi
        fi
    done
}

# 使用重试逻辑运行 claude（支持安全模式）
# 用法：run_claude "prompt" "PHASE_NAME"
run_claude() {
    local user_prompt="$1"
    local phase="${2:-UNKNOWN}"
    local attempt=1
    local exit_code=0
    local claude_log_file=""
    local output=""

    # 将详细输出规则附加到所有提示词（在末尾 = 更显眼）
    local prompt="$user_prompt"
    local prompt_size=${#prompt}

    log "INFO" "启动 $phase 阶段（提示词：$prompt_size 字节）"

    while [[ $attempt -le $MAX_RETRIES ]]; do
        # 为此次尝试生成 claude 输出日志文件
        local timestamp=$(date '+%Y%m%d_%H%M%S')
        claude_log_file="$LOG_DIR/claude_${phase,,}_${timestamp}_attempt${attempt}.log"

        # 写入日志头部
        {
            echo "=============================================================================="
            echo "CLAUDE 输入/输出日志"
            echo "=============================================================================="
            echo "时间戳: $(date '+%Y-%m-%d %H:%M:%S')"
            echo "阶段: $phase"
            echo "尝试: $attempt/$MAX_RETRIES"
            echo "提示词大小: $prompt_size 字节"
            echo ""
            echo "------------------------------------------------------------------------------"
            echo "发送给Claude的 PROMPT (总共 $prompt_size 字节） :"
            echo "------------------------------------------------------------------------------"
            echo "$prompt"
            echo ""
            echo "------------------------------------------------------------------------------"
            echo "CLAUDE 输出:"
            echo "------------------------------------------------------------------------------"
        } > "$claude_log_file"

        # 在主机上运行，使用 jq 格式化 JSON 输出，同时保存原始输出到日志
        {
            claude --verbose -p  --output-format stream-json --dangerously-skip-permissions "$prompt" 2>&1
        } | tee -a "$claude_log_file" | process_json_stream
        # 从管道获取退出码
        exit_code=${PIPESTATUS[0]}

        # 写入日志尾部
        {
            echo ""
            echo "------------------------------------------------------------------------------"
            echo "退出码: $exit_code"
            echo "=============================================================================="
        } >> "$claude_log_file"

        # 显示日志文件位置
        if [[ $exit_code -eq 0 ]]; then
            echo -e "${CYAN}  [日志] $claude_log_file${NC}"
            log "INFO" "$phase 阶段完成->成功 (日志: $claude_log_file)"
            return 0
        fi

        # 检查特定的流式错误
        output=$(tail -100 "$claude_log_file")
        if echo "$output" | grep -q "only prompt commands are supported in streaming mode"; then
            log "ERROR" "$phase: 收到流式模式错误 (第 $attempt 次尝试)"
            echo -e "${YELLOW}  Claude 失败 (第 $attempt/$MAX_RETRIES 次尝试, 退出码: $exit_code)${NC}"
            echo -e "${RED}  错误: '仅支持流式模式下的提示命令'${NC}"
        else
            echo -e "${YELLOW}  Claude 失败 (第 $attempt/$MAX_RETRIES 次尝试, 退出码: $exit_code)${NC}"
        fi

        echo -e "${CYAN}  [日志] $claude_log_file${NC}"

        # 记录故障详情，包括实际提示词
        log_failure "$phase" "$attempt" "$exit_code" "$output" "$prompt_size" "$prompt"

        if [[ $attempt -lt $MAX_RETRIES ]]; then
            echo -e "${YELLOW}  ${RETRY_DELAY}s 后重试...${NC}"
            sleep $RETRY_DELAY
        fi

        ((attempt++))
    done

    echo -e "${RED}  已达最大重试次数 ($MAX_RETRIES 次)${NC}"
    log "ERROR" "$phase 阶段在 $MAX_RETRIES 次尝试后失败"
    echo -e "${YELLOW}  查看详细日志: $LOG_DIR/claude_${phase,,}_*.log${NC}"
    return 1
}

#==============================================================================
# INIT 命令 - 从想法文件引导项目（适用于新项目或现有项目）
#==============================================================================
if [[ "$1" == "init" ]]; then
    IDEA_FILE="idea.md"

    shift  # 从参数中删除 "init"
    if [[ $# -gt 0 ]]; then
        echo -e "${RED}错误: 不支持的参数 '$1'${NC}"
        echo -e "${YELLOW}用法: bjarne init${NC}"
        echo -e "${YELLOW}init 命令固定使用 idea.md 文件，无需指定文件名${NC}"
        exit 1
    fi

    if [[ ! -f "$IDEA_FILE" ]]; then
        echo -e "${RED}错误: 未找到 $IDEA_FILE 文件${NC}"
        echo ""
        echo -e "${CYAN}请先创建 idea.md 文件来描述你的项目想法${NC}"
        echo -e "${YELLOW}示例:${NC}"
        echo "  echo '# 我的项目想法' > idea.md"
        echo "  或者使用你喜欢的编辑器创建 idea.md"
        echo ""
        echo -e "${YELLOW}然后运行: bjarne init${NC}"
        exit 1
    fi

    INIT_PROMPT=$(load_prompt "init.md")

    run_claude "$INIT_PROMPT" "INIT"

    # 验证文件是否已创建
    if [[ -f "$CONTEXT_FILE" ]] && [[ -f "$TASK_FILE" ]]; then
        echo -e "${GREEN}项目初始化成功!${NC}"
        echo -e "  - $CONTEXT_FILE"
        echo -e "  - $TASK_FILE"
        [[ -d "$SPECS_DIR" ]] && echo -e "  - $SPECS_DIR/"
        echo ""
        echo -e "${CYAN}运行 'bjarne' 开始开发${NC}"
    else
        echo -e "${RED}初始化不完整 - 请检查上方输出${NC}"
    fi

    exit 0
fi

#==============================================================================
# REFRESH 命令 - 从自由格式笔记添加任务
#==============================================================================
if [[ "$1" == "refresh" ]]; then
    NOTES_FILE="$2"

    if [[ -z "$NOTES_FILE" ]]; then
        echo -e "${RED}用法: bjarne refresh <notes.md>${NC}"
        exit 1
    fi

    if [[ ! -f "$NOTES_FILE" ]]; then
        echo -e "${RED}错误: 未找到 $NOTES_FILE${NC}"
        exit 1
    fi

    if [[ ! -f "$CONTEXT_FILE" ]]; then
        echo -e "${RED}错误: 未找到 $CONTEXT_FILE - 请先运行 'bjarne init'${NC}"
        exit 1
    fi

    if [[ ! -f "$TASK_FILE" ]]; then
        echo -e "${RED}错误: 未找到 $TASK_FILE - 请先运行 'bjarne init'${NC}"
        exit 1
    fi

    echo -e "${CYAN}Bjarne 正在从 $NOTES_FILE 刷新项目${NC}"

    REFRESH_PROMPT=$(load_prompt "refresh.md")

    NOTES_CONTENT=$(cat "$NOTES_FILE")

    run_claude "# 用户的笔记:

$NOTES_CONTENT

---

$REFRESH_PROMPT" "REFRESH"

    # 显示结果
    NEW_TASKS=$(grep -c '^\s*- \[ \]' "$TASK_FILE" 2>/dev/null || echo "0")
    echo -e "${GREEN}项目已刷新!${NC}"
    echo -e "  - $TASK_FILE 中有 $NEW_TASKS 个待处理任务"
    echo ""
    echo -e "${CYAN}运行 'bjarne' 来处理新任务${NC}"

    exit 0
fi

#==============================================================================
# 主循环 - 规划 → 执行 → 评审 → 修复
#==============================================================================

# 解析主循环参数
MAX_ITERATIONS=25
START_PHASE="plan"  # 默认从 plan 开始，可选: plan, exec, review, fix

while [[ $# -gt 0 ]]; do
    case "$1" in
        -p)
            # 指定起始阶段
            START_PHASE="$2"
            shift 2
            # 验证阶段名称
            case "$START_PHASE" in
                plan|exec|review|fix)
                    ;;
                *)
                    echo -e "${RED}错误: 无效的阶段 '$START_PHASE'${NC}"
                    echo -e "${YELLOW}有效阶段: plan, exec, review, fix${NC}"
                    exit 1
                    ;;
            esac
            ;;
        [0-9]*)
            MAX_ITERATIONS="$1"
            shift
            ;;
        *)
            echo -e "${RED}未知选项: $1${NC}"
            echo "用法: bjarne [options] [iterations]"
            echo "选项:"
            echo "  -p <phase>    从指定阶段开始 (plan|exec|review|fix)"
            exit 1
            ;;
    esac
done

# 检查必需文件
if [[ ! -f "$TASK_FILE" ]]; then
    echo -e "${RED}错误: 未找到 $TASK_FILE${NC}"
    echo -e "请先运行 'bjarne init' (需要 idea.md 文件)"
    exit 1
fi

if [[ ! -f "$CONTEXT_FILE" ]]; then
    echo -e "${YELLOW}警告: 未找到 $CONTEXT_FILE${NC}"
fi

# 记录会话开始
log "INFO" "=== Bjarne 会话开始 ==="
log "INFO" "最大迭代次数: $MAX_ITERATIONS, 起始阶段: $START_PHASE"
log "INFO" "工作目录: $(pwd)"

echo -e "${CYAN}Bjarne 启动中 - 最多 $MAX_ITERATIONS 轮迭代${NC}"
if [[ "$START_PHASE" != "plan" ]]; then
    echo -e "${CYAN}从 ${START_PHASE} 阶段开始${NC}"
fi
echo -e "${CYAN}循环: 规划 → 执行 → 评审 → 修复${NC}"
echo -e "${CYAN}日志: $LOG_FILE${NC}"
echo ""

for i in $(seq 1 $MAX_ITERATIONS); do
    # 检查剩余任务
    if ! grep -q '^\s*- \[ \]' "$TASK_FILE"; then
        echo -e "${GREEN}所有任务已完成!${NC}"
        rm -f "$TASK_STATE"
        exit 0
    fi

    REMAINING=$(grep -c '^\s*- \[ \]' "$TASK_FILE" || echo "0")
    echo -e "${YELLOW}=== 第 $i/$MAX_ITERATIONS 轮 (剩余 $REMAINING 个任务) ===${NC}"

    # PLAN (如果从 plan 或更早阶段开始)
    if [[ "$START_PHASE" == "plan" ]]; then
        echo -e "${BLUE}[1/4 规划]${NC} 分析中..."
        if ! run_claude "$PLAN_PROMPT" "PLAN"; then
            echo -e "${RED}规划阶段在 $MAX_RETRIES 次重试后失败 - 中止${NC}"
            exit 1
        fi

        if [[ ! -f "$TASK_STATE_PLAN" ]]; then
            echo -e "${RED}规划失败 - 未找到 $TASK_STATE_PLAN 文件${NC}"
            continue
        fi
    fi

    # EXECUTE (如果从 exec 或更早阶段开始)
    if [[ "$START_PHASE" == "plan" ]] || [[ "$START_PHASE" == "exec" ]]; then
        echo -e "${BLUE}[2/4 执行]${NC} 实现中..."
        if ! run_claude "$EXECUTE_PROMPT" "EXECUTE"; then
            echo -e "${RED}执行阶段在 $MAX_RETRIES 次重试后失败 - 中止${NC}"
            exit 1
        fi
    fi

    # REVIEW (如果从 review 或更早阶段开始)
    if [[ "$START_PHASE" == "plan" ]] || [[ "$START_PHASE" == "exec" ]] || [[ "$START_PHASE" == "review" ]]; then
        echo -e "${BLUE}[3/4 评审]${NC} 评审中..."
        if ! run_claude "$REVIEW_PROMPT" "REVIEW"; then
            echo -e "${RED}评审阶段在 $MAX_RETRIES 次重试后失败 - 中止${NC}"
            exit 1
        fi
    fi

    # FIX (始终执行，除非是只读模式)
    echo -e "${BLUE}[4/4 修复]${NC} 修复中..."
    if ! run_claude "$FIX_PROMPT" "FIX"; then
        echo -e "${RED}修复阶段在 $MAX_RETRIES 次重试后失败 - 中止${NC}"
        exit 1
    fi

    # 第一轮后，重置起始阶段为 plan（正常循环）
    if [[ "$i" == 1 ]] && [[ "$START_PHASE" != "plan" ]]; then
        echo -e "${CYAN}恢复为完整循环（从 plan 开始）${NC}"
        START_PHASE="plan"
    fi

    sleep 2
done

echo -e "${YELLOW}已达到最大迭代次数${NC}"
