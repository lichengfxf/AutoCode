# Generate task ID from description (uses first line only for slug)
generate_task_id() {
    local description="$1"
    local timestamp=$(date +%s)
    # Use only first non-empty line for slug (handles multi-line markdown)
    local first_line=$(echo "$description" | grep -v '^#' | grep -v '^$' | head -1)
    local slug=$(echo "$first_line" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g' | sed 's/--*/-/g' | cut -c1-30)
    echo "${timestamp}-${slug}"
}

# Run claude with retry logic (safe mode aware)
# Usage: run_claude "prompt" "PHASE_NAME"
run_claude() {
    local user_prompt="$1"
    local phase="${2:-UNKNOWN}"
    local attempt=1
    local exit_code=0
    local claude_log_file=""
    local output=""

    # APPEND verbose output rules to ALL prompts (at end = more prominent)
    local prompt="$user_prompt

$(get_verbose_output_rules)"
    local prompt_size=${#prompt}

    log "INFO" "Starting $phase phase (prompt: $prompt_size bytes)"

    while [[ $attempt -le $MAX_RETRIES ]]; do
        # Generate claude output log file for this attempt
        local timestamp=$(date '+%Y%m%d_%H%M%S')
        claude_log_file="$LOG_DIR/claude_${phase,,}_${timestamp}_attempt${attempt}.log"

        # Write log header
        {
            echo "=============================================================================="
            echo "CLAUDE 输出日志 - 实时"
            echo "=============================================================================="
            echo "Timestamp: $(date '+%Y-%m-%d %H:%M:%S')"
            echo "Phase: $phase"
            echo "Attempt: $attempt/$MAX_RETRIES"
            echo "Prompt Size: $prompt_size bytes"
            echo ""
            echo "------------------------------------------------------------------------------"
            echo "发送的 PROMPT (前 5000 字符):"
            echo "------------------------------------------------------------------------------"
            echo "${prompt:0:5000}"
            if [[ ${#prompt} -gt 5000 ]]; then
                echo "... (已截断，总共 $prompt_size 字节)"
            fi
            echo ""
            echo "------------------------------------------------------------------------------"
            echo "CLAUDE 输出 (实时):"
            echo "------------------------------------------------------------------------------"
        } > "$claude_log_file"

        # Run claude with tee to output to both screen and file in real-time
        if [[ "$SAFE_MODE" == true ]]; then
            # Run in Docker container (as 'bjarne' user, not root)
            local docker_args="-v $(pwd):/workspace"
            docker_args+=" -v $HOME/.claude/.credentials.json:/home/bjarne/.claude/.credentials.json:ro"

            # Add gh CLI config if available (for PR creation in task mode)
            if [[ -d "$HOME/.config/gh" ]]; then
                docker_args+=" -v $HOME/.config/gh:/home/bjarne/.config/gh:ro"
            fi

            # Add gitconfig if available (for commits)
            if [[ -f "$HOME/.gitconfig" ]]; then
                docker_args+=" -v $HOME/.gitconfig:/home/bjarne/.gitconfig:ro"
            fi

            # Add dependency volume if applicable
            local dep_volume=$(get_dep_volume "$PROJECT_NAME")
            if [[ -n "$dep_volume" ]]; then
                docker_args+=" -v $dep_volume"
            fi

            # Mount temp folder for verbose output logs (same path inside container)
            docker_args+=" -v $BJARNE_TMP_DIR:$BJARNE_TMP_DIR"

            # Run with tee for real-time output to both screen and file
            docker run --rm --user "$(id -u):$(id -g)" -e HOME=/home/bjarne \
                $docker_args -w /workspace "$IMAGE_NAME" \
                claude -p --dangerously-skip-permissions "$prompt" 2>&1 | tee -a "$claude_log_file"
            # Get exit code from pipe (use PIPESTATUS)
            exit_code=${PIPESTATUS[0]}
        else
            # Run on host with tee for real-time output
            claude -p --dangerously-skip-permissions "$prompt" 2>&1 | tee -a "$claude_log_file"
            # Get exit code from pipe
            exit_code=${PIPESTATUS[0]}
        fi

        # Write log footer
        {
            echo ""
            echo "------------------------------------------------------------------------------"
            echo "Exit Code: $exit_code"
            echo "=============================================================================="
        } >> "$claude_log_file"

        # Show log file location
        if [[ $exit_code -eq 0 ]]; then
            echo -e "${CYAN}  [日志] $claude_log_file${NC}"
            log "INFO" "$phase 阶段完成->成功 (日志: $claude_log_file)"
            return 0
        fi

        # Check for the specific streaming error
        output=$(tail -100 "$claude_log_file")
        if echo "$output" | grep -q "only prompt commands are supported in streaming mode"; then
            log "ERROR" "$phase: 收到流式模式错误 (第 $attempt 次尝试)"
            echo -e "${YELLOW}  Claude 失败 (第 $attempt/$MAX_RETRIES 次尝试, 退出码: $exit_code)${NC}"
            echo -e "${RED}  错误: '仅支持流式模式下的提示命令'${NC}"
        else
            echo -e "${YELLOW}  Claude 失败 (第 $attempt/$MAX_RETRIES 次尝试, 退出码: $exit_code)${NC}"
        fi

        echo -e "${CYAN}  [日志] $claude_log_file${NC}"

        # Log failure details including the actual prompt
        log_failure "$phase" "$attempt" "$exit_code" "$output" "$prompt_size" "$prompt"

        if [[ $attempt -lt $MAX_RETRIES ]]; then
            echo -e "${YELLOW}  ${RETRY_DELAY}s 后重试...${NC}"
            sleep $RETRY_DELAY
        fi

        ((attempt++))
    done

    echo -e "${RED}  已达最大重试次数 ($MAX_RETRIES 次)${NC}"
    log "ERROR" "$phase 阶段在 $MAX_RETRIES 次尝试后失败"
    echo -e "${YELLOW}  查看详细日志: $LOG_DIR/claude_${phase,,}_*.log${NC}"
    return 1
}

#==============================================================================
# INIT COMMAND - Bootstrap from idea file (works on new or existing projects)
#==============================================================================
if [[ "$1" == "init" ]]; then
    # Parse --safe flag and idea file
    INIT_SAFE_MODE=false
    IDEA_FILE=""

    shift  # Remove "init" from args
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --safe)
                INIT_SAFE_MODE=true
                shift
                ;;
            *)
                IDEA_FILE="$1"
                shift
                ;;
        esac
    done

    if [[ -z "$IDEA_FILE" ]]; then
        echo -e "${RED}用法: bjarne init [--safe] <idea.md>${NC}"
        exit 1
    fi

    if [[ ! -f "$IDEA_FILE" ]]; then
        echo -e "${RED}错误: 未找到 $IDEA_FILE${NC}"
        exit 1
    fi

    # Detect if this is an existing project (has source code files)
    EXISTING_PROJECT="false"
    SRC_FILES=$(find . -maxdepth 3 -type f \( -name "*.js" -o -name "*.ts" -o -name "*.py" -o -name "*.php" -o -name "*.go" -o -name "*.rs" -o -name "*.java" -o -name "*.tsx" -o -name "*.jsx" \) 2>/dev/null | grep -v node_modules | grep -v vendor | grep -v __pycache__ | head -20)
    [[ -n "$SRC_FILES" ]] && EXISTING_PROJECT="true"

    if [[ "$EXISTING_PROJECT" == "true" ]]; then
        echo -e "${CYAN}Bjarne 正在从 $IDEA_FILE 初始化现有项目${NC}"
    else
        echo -e "${CYAN}Bjarne 正在从 $IDEA_FILE 初始化新项目${NC}"
    fi

    # Detect existing environment
    DETECTED=""
    [[ -f "package.json" ]] && DETECTED="${DETECTED}找到: package.json (Node.js/JavaScript)\n"
    [[ -f "tsconfig.json" ]] && DETECTED="${DETECTED}找到: tsconfig.json (TypeScript)\n"
    [[ -f "composer.json" ]] && DETECTED="${DETECTED}找到: composer.json (PHP)\n"
