                    WORKTREE_PATH=""
                    WORKTREE_BRANCH=""
                fi
            fi

            if [[ -n "$WORKTREE_PATH" ]] && [[ -d "$WORKTREE_PATH" ]]; then
                echo -e "${GREEN}在隔离的 worktree 中工作: $WORKTREE_PATH${NC}"
                echo -e "${GREEN}分支: $WORKTREE_BRANCH${NC}"
