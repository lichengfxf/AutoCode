                INIT_SAFE_MODE=true
                shift
                ;;
            *)
                echo -e "${RED}错误: 不支持的参数 '$1'${NC}"
                echo -e "${YELLOW}用法: bjarne init [--safe]${NC}"
                echo -e "${YELLOW}init 命令固定使用 idea.md 文件，无需指定文件名${NC}"
                exit 1
                ;;
        esac
    done

    if [[ ! -f "$IDEA_FILE" ]]; then
        echo -e "${RED}错误: 未找到 $IDEA_FILE 文件${NC}"
        echo ""
        echo -e "${CYAN}请先创建 idea.md 文件来描述你的项目想法${NC}"
        echo -e "${YELLOW}示例:${NC}"
        echo "  echo '# 我的项目想法' > idea.md"
        echo "  或者使用你喜欢的编辑器创建 idea.md"
        echo ""
        echo -e "${YELLOW}然后运行: bjarne init [--safe]${NC}"
        exit 1
    fi

    INIT_PROMPT=$(load_prompt "init.md")

    run_claude "$INIT_PROMPT" "INIT"

    # 验证文件是否已创建
    if [[ -f "$CONTEXT_FILE" ]] && [[ -f "$TASK_FILE" ]]; then
        echo -e "${GREEN}项目初始化成功!${NC}"
        echo -e "  - $CONTEXT_FILE"
        echo -e "  - $TASK_FILE"
        [[ -d "$SPECS_DIR" ]] && echo -e "  - $SPECS_DIR/"

        # 如果使用了 --safe 标志，则生成 Docker 配置
        if [[ "$INIT_SAFE_MODE" == true ]]; then
            echo -e "${CYAN}正在为安全模式生成 Docker 配置...${NC}"
            generate_dockerfile

            # 将 .bjarne 添加到 .gitignore（如果尚未添加）
            if [[ -f ".gitignore" ]]; then
                if ! grep -q "^\.bjarne/" ".gitignore" 2>/dev/null; then
                    echo ".bjarne/" >> ".gitignore"
                fi
            else
                echo ".bjarne/" > ".gitignore"
            fi
            echo -e "  - Added .bjarne/ to .gitignore"

            echo ""
            echo -e "${GREEN}安全模式已启用!${NC}"
            echo -e "容器将只能访问此项目目录。"
        fi

        echo ""
        echo -e "${CYAN}运行 'bjarne' 开始开发${NC}"
    else
        echo -e "${RED}初始化不完整 - 请检查上方输出${NC}"
    fi

    exit 0
fi

