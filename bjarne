    [[ -d "node_modules" ]] || [[ -f "package.json" ]] && [[ ! -d "node_modules" ]] && DETECTED="${DETECTED}注意: 缺少 node_modules - 需要 npm install\n"
    [[ -d "vendor" ]] || [[ -f "composer.json" ]] && [[ ! -d "vendor" ]] && DETECTED="${DETECTED}注意: 缺少 vendor - 需要 composer install\n"

    # For existing projects, include source file list
