#!/bin/bash
# Bjarne - Autonomous AI development system
#
# Commands:
#   bjarne init [--safe] <idea.md>  - Bootstrap project from idea file
#   bjarne refresh <notes.md>       - Add tasks from freeform notes
#   bjarne task [opts] "desc"       - Run isolated single-task mode
#   bjarne [opts] [n]               - Run n iterations (default 25)
#   bjarne --rebuild                - Force rebuild Docker image (safe mode only)
#   bjarne --update                 - Check for updates immediately
#   bjarne --disable-auto-update    - Disable automatic update checks
#   bjarne --enable-auto-update     - Re-enable automatic update checks
#
# Main loop options:
#   --batch             - Enable batch mode (up to 5 related tasks per iteration)
#   --batch=N, -bN      - Enable batch mode with custom size (up to N tasks)
#                         Tasks are grouped by natural relatedness, not forced
#
# Task mode options:
#   --safe              - Run in Docker container
#   -f, --file <file>   - Read task description from file
#   --branch <name>     - Use custom branch name
#   --no-pr             - Skip PR creation
#   -n <num>            - Max iterations (default 25)
#
# Safe mode (--safe): Runs Claude in a Docker container that can only access
# the project directory. Use for unattended runs to prevent accidental
# damage to other files on the system.
#
# Loop: PLAN → EXECUTE → REVIEW → FIX
#
# Task mode: Isolated single-task fixes. Does NOT touch CONTEXT.md, TASKS.md.
# Uses .bjarne/tasks/<task-id>/ for state. Auto-creates branch and PR if git/gh available.
#
# idea.md/notes.md are freeform - write whatever you want. Bjarne will figure it out.
#
# PROMPTS DIRECTORY
#
# All AI prompts are stored in the prompts/ directory (relative to this script).
# This separation allows prompts to be edited independently from the script logic.
#
# File Types:
#   - *.md: Static prompts (loaded as-is)
#   - *.template: Prompts requiring variable substitution
#
# To add or modify prompts:
#   1. Edit/create files in the prompts/ directory
#   2. Use load_prompt() for static content, load_prompt_with_subst() for templates
#   3. See prompts/README.md for detailed documentation
#

set -e

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
RED='\033[0;31m'
CYAN='\033[0;36m'
NC='\033[0m'

# Files
TASK_FILE="TASKS.md"
CONTEXT_FILE="CONTEXT.md"
SPECS_DIR="specs"
TASK_STATE=".task"

# Retry settings
MAX_RETRIES=5
RETRY_DELAY=10

# Logging (use absolute path to survive worktree cd)
BJARNE_PROJECT_ROOT="$(pwd)"
LOG_DIR="$BJARNE_PROJECT_ROOT/.bjarne/logs"
LOG_FILE="$LOG_DIR/bjarne.log"

# Script directory and prompts location (use absolute path for reliability)
BJARNE_SCRIPT_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
PROMPTS_DIR="$BJARNE_SCRIPT_DIR/prompts"

# Auto-update settings
BJARNE_CONFIG_DIR="$HOME/.bjarne"
BJARNE_LAST_UPDATE_CHECK="$BJARNE_CONFIG_DIR/last_update_check"
BJARNE_UPDATE_DISABLED="$BJARNE_CONFIG_DIR/auto_update_disabled"
BJARNE_UPDATE_INTERVAL=$((2 * 24 * 60 * 60))  # 2 days in seconds
BJARNE_REMOTE_URL="https://raw.githubusercontent.com/lichengfxf/AutoCode/refs/heads/master/bjarne"

#==============================================================================
# AUTO-UPDATE FUNCTIONS
#==============================================================================

# Check for updates (runs every 2 days, or immediately if --check-now is passed)
check_for_updates() {
    local check_now="$1"  # If "true", skip the time interval check

    # Skip if auto-update is disabled
    if [[ -f "$BJARNE_UPDATE_DISABLED" ]]; then
        return 0
    fi

    # Create config dir if needed
    mkdir -p "$BJARNE_CONFIG_DIR"

    local now=$(date +%s)

    # Check if we need to check (every 2 days), unless --check-now is passed
    if [[ "$check_now" != "true" ]]; then
        if [[ -f "$BJARNE_LAST_UPDATE_CHECK" ]]; then
            local last_check=$(cat "$BJARNE_LAST_UPDATE_CHECK" 2>/dev/null || echo "0")
            if (( now - last_check < BJARNE_UPDATE_INTERVAL )); then
                return 0  # Not time to check yet
            fi
        fi
    fi

    # Record this check time
    echo "$now" > "$BJARNE_LAST_UPDATE_CHECK"

    # Get path to this script
    local script_path
    script_path=$(realpath "$0" 2>/dev/null || readlink -f "$0" 2>/dev/null || echo "$0")

    # Fetch remote script to temp file
    local temp_remote=$(mktemp)
    if ! curl -fsSL "$BJARNE_REMOTE_URL" -o "$temp_remote" 2>/dev/null; then
        rm -f "$temp_remote"
        return 0  # Silently fail if can't fetch
    fi

    # Compare hashes
    local local_hash=$(sha256sum "$script_path" 2>/dev/null | cut -d' ' -f1)
    local remote_hash=$(sha256sum "$temp_remote" 2>/dev/null | cut -d' ' -f1)

    if [[ "$local_hash" == "$remote_hash" ]]; then
        rm -f "$temp_remote"
        return 0  # Already up to date
    fi

    # Update available - ask user
    echo -e "${CYAN}bjarne 有新版本可用。${NC}"
    echo -n "是否更新? [y/N] "
    read -r response

    if [[ ! "$response" =~ ^[Yy]$ ]]; then
        echo -e "${YELLOW}已跳过更新。${NC}"
        rm -f "$temp_remote"
        return 0
    fi

    # Perform update
    echo -e "${CYAN}正在更新 bjarne...${NC}"

    # Check if we need sudo
    if [[ -w "$script_path" ]]; then
        cp "$temp_remote" "$script_path"
        chmod +x "$script_path"
    else
        echo -e "${YELLOW}需要提升权限来更新 ${script_path}${NC}"
        if ! sudo cp "$temp_remote" "$script_path"; then
            echo -e "${RED}更新失败 - 无法写入 ${script_path}${NC}"
            rm -f "$temp_remote"
            return 1
        fi
        sudo chmod +x "$script_path"
    fi

    rm -f "$temp_remote"

    echo -e "${GREEN}bjarne 更新成功!${NC}"
    echo -e "${YELLOW}请重新运行命令: bjarne $*${NC}"
    exit 0
}

#==============================================================================
# AUTO-UPDATE TOGGLE COMMANDS
#==============================================================================

if [[ "$1" == "--disable-auto-update" ]]; then
    mkdir -p "$BJARNE_CONFIG_DIR"
    touch "$BJARNE_UPDATE_DISABLED"
    echo -e "${GREEN}自动更新已禁用。${NC}"
    echo -e "要重新启用: bjarne --enable-auto-update"
    exit 0
fi

if [[ "$1" == "--enable-auto-update" ]]; then
    rm -f "$BJARNE_UPDATE_DISABLED"
    echo -e "${GREEN}自动更新已启用。${NC}"
    exit 0
fi

if [[ "$1" == "--update" ]]; then
    # Force update check now, ignoring the 2-day interval
    echo -e "${CYAN}正在检查更新...${NC}"
    check_for_updates "true"
    exit 0
fi

#==============================================================================
# RUN UPDATE CHECK (before processing commands)
#==============================================================================

# Pass original args so the exit message can tell user what to re-run
check_for_updates "$@"

# Ensure log directory exists
mkdir -p "$LOG_DIR"

# Instance-specific temp folder for verbose command output
# Uses PID + timestamp for uniqueness across concurrent instances
BJARNE_INSTANCE_ID="$$_$(date +%s)"
BJN_BJARNE_TMP_DIR="/tmp/bjarne-${BJARNE_INSTANCE_ID}"
export BJN_BJARNE_TMP_DIR
mkdir -p "$BJN_BJARNE_TMP_DIR"

# Cleanup function for temp folder
cleanup_temp() {
    if [[ -d "$BJN_BJARNE_TMP_DIR" ]]; then
        rm -rf "$BJN_BJARNE_TMP_DIR"
    fi
}

# Trap signals to ensure cleanup on exit (normal, interrupt, terminate)
trap cleanup_temp EXIT INT TERM

# Log function
log() {
    local level="$1"
    local msg="$2"
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    echo "[$timestamp] [$level] $msg" >> "$LOG_FILE"
}

# Log with context (for failures)
log_failure() {
    local phase="$1"
    local attempt="$2"
    local exit_code="$3"
    local output="$4"
    local prompt_size="$5"
    local prompt="$6"

    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    local fail_file="$LOG_DIR/failure_${timestamp//[: -]/_}.log"

    {
        echo "=== BJARNE 故障日志 ==="
        echo "Timestamp: $timestamp"
        echo "Phase: $phase"
        echo "Attempt: $attempt/$MAX_RETRIES"
        echo "Exit code: $exit_code"
        echo "Prompt size: $prompt_size bytes"
        echo "Working directory: $(pwd)"
        echo "Safe mode: $SAFE_MODE"
        echo ""
        echo "=== CLAUDE 输出 ==="
        echo "$output"
        echo ""
        echo "=== 实际发送的 PROMPT ==="
        echo "$prompt"
        echo ""
        echo "=== 当前 .task 文件 (如果存在) ==="
        if [[ -f "$TASK_STATE" ]]; then
            cat "$TASK_STATE"
        else
            echo "(无 .task 文件)"
        fi
    } > "$fail_file"

    log "ERROR" "Failure logged to $fail_file"
    echo -e "${YELLOW}  故障详情已保存到: $fail_file${NC}"
}

# Safe mode (Docker) settings
BJARNE_DIR=".bjarne"
DOCKERFILE="$BJARNE_DIR/Dockerfile"
SAFE_MODE=false
IMAGE_NAME=""

#==============================================================================
# PROMPTS - Defined early so both task mode and main loop can use them
#==============================================================================
#
# The prompts/ directory contains all AI prompt templates used by bjarne.
#
# Directory Structure:
#   prompts/
#   ├── plan.md              - Main planning phase prompt
#   ├── execute.md           - Code execution phase prompt
#   ├── review.md            - Review and validation prompt
#   ├── fix.md               - Error fixing prompt
#   ├── init.md              - Project initialization prompt
#   ├── refresh.md           - Context refresh prompt
#   ├── decompose.md         - Task decomposition prompt
#   ├── finalize-worktree.md - Finalization with git worktree support
#   ├── finalize.md          - Standard finalization prompt
#   ├── batch-plan.md.template     - Batch mode planning (requires $BJN_BJN_BATCH_SIZE)
#   ├── batch-execute.md           - Batch mode execution
#   ├── batch-review.md            - Batch mode review
#   ├── batch-fix.md               - Batch mode fixing
#   ├── dockerfile.template        - Dockerfile generation (requires $BJN_base_image)
#   └── verbose-rules.template     - Verbose output rules (requires $BJN_BJARNE_TMP_DIR)
#
# File Naming Conventions:
#   - *.md files: Static prompts loaded as-is
#   - *.template files: Require variable substitution (use load_prompt_with_subst)
#
# Usage Guidelines:
#   - Use load_prompt() for static *.md files
#   - Use load_prompt_with_subst() for *.template files or when variables need substitution
#   - Always specify only the variables you intend to replace for safety
#
# Adding New Prompts:
#   1. Create the file in prompts/ directory
#   2. Use .md extension for static content, .template for content with variables
#   3. Load using load_prompt() or load_prompt_with_subst() as appropriate
#   4. Variables in templates should use $VAR_NAME format and be documented
#

# Load prompt content from file with support for relative and absolute paths
# Usage: load_prompt <prompt_file>
# Args:
#   prompt_file: Can be relative (e.g., "plan.md") or absolute (e.g., "/full/path/to/plan.md")
# Returns: 0 on success, 1 if file not found
# Note: Relative paths are resolved relative to $PROMPTS_DIR
load_prompt() {
    local prompt_file="$1"
    local full_path

    # Determine if path is absolute or relative
    if [[ "$prompt_file" = /* ]]; then
        # Absolute path - use as-is
        full_path="$prompt_file"
    else
        # Relative path - resolve relative to PROMPTS_DIR
        full_path="$PROMPTS_DIR/$prompt_file"
    fi

    # Validate file exists
    if [[ ! -f "$full_path" ]]; then
        log "ERROR" "Prompt file not found: $full_path"
        return 1
    fi

    cat "$full_path"
}

# Load prompt content from template files and perform variable substitution
# Usage: load_prompt_with_subst <template_file> [variables_to_substitute]
# Args:
#   template_file: Can be relative (e.g., "dockerfile.template") or absolute path
#   variables_to_substitute: Optional list of variables to substitute (e.g., "$BJN_base_image")
# Returns: 0 on success, 1 if file not found
# Examples:
#   load_prompt_with_subst "dockerfile.template"              # substitute all env vars
#   load_prompt_with_subst "dockerfile.template" '$BJN_base_image' # only substitute $BJN_base_image
# Note: Relative paths are resolved relative to $PROMPTS_DIR
load_prompt_with_subst() {
    local template_file="$1"
    local full_path

    # Determine if path is absolute or relative
    if [[ "$template_file" = /* ]]; then
        # Absolute path - use as-is
        full_path="$template_file"
    else
        # Relative path - resolve relative to PROMPTS_DIR
        full_path="$PROMPTS_DIR/$template_file"
    fi

    # Validate file exists
    if [[ ! -f "$full_path" ]]; then
        log "ERROR" "Template file not found: $full_path"
        return 1
    fi

    shift  # Remove filename from args
    local vars="$*"  # Get variable list (optional)

    if [[ -n "$vars" ]]; then
        # Only substitute specified variables
        envsubst "$vars" < "$full_path"
    else
        # Substitute all environment variables
        envsubst < "$full_path"
    fi
}

PLAN_PROMPT=$(load_prompt "plan.md")
EXECUTE_PROMPT=$(load_prompt "execute.md")

REVIEW_PROMPT=$(load_prompt "review.md")
FIX_PROMPT=$(load_prompt "fix.md")

#==============================================================================
# VERBOSE OUTPUT RULES - Injected into all prompts to save tokens
#==============================================================================

# Generate verbose output rules with current temp folder path
get_verbose_output_rules() {
    load_prompt_with_subst "verbose-rules.template"
}

#==============================================================================
# SAFE MODE FUNCTIONS
#==============================================================================

# Detect if project uses safe mode
detect_safe_mode() {
    if [[ -f "$DOCKERFILE" ]]; then
        # Check if Docker is available
        if ! command -v docker &>/dev/null; then
            echo -e "${RED}错误: 安全模式需要 Docker 但未找到${NC}"
            exit 1
        fi

        # Check if credentials exist
        if [[ ! -f "$HOME/.claude/.credentials.json" ]]; then
            echo -e "${RED}错误: 在 ~/.claude/.credentials.json 未找到 Claude 凭证${NC}"
            echo -e "请先在主机上运行 'claude' 进行认证"
            exit 1
        fi

        SAFE_MODE=true
        # Generate image name from current directory
        PROJECT_NAME=$(basename "$(pwd)" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9-]/-/g')
        IMAGE_NAME="bjarne-${PROJECT_NAME}"
    fi
}

# Build Docker image if needed
build_docker_image() {
    local force_rebuild="$1"

    if [[ "$force_rebuild" == "true" ]] || ! docker image inspect "$IMAGE_NAME" &>/dev/null 2>&1; then
        echo -e "${CYAN}正在构建 Docker 镜像: $IMAGE_NAME${NC}"
        docker build -t "$IMAGE_NAME" -f "$DOCKERFILE" . || {
            echo -e "${RED}Docker 构建失败${NC}"
            exit 1
        }
        echo -e "${GREEN}镜像构建成功${NC}"
    else
        echo -e "${CYAN}使用缓存的镜像: $IMAGE_NAME${NC}"
    fi
}

# Get appropriate Docker base image for detected tech stack
get_BJN_base_image() {
    if [[ -f "package.json" ]]; then
        echo "node:22-bookworm"
    elif [[ -f "requirements.txt" ]] || [[ -f "pyproject.toml" ]]; then
        echo "python:3.12-bookworm"
    elif [[ -f "Cargo.toml" ]]; then
        echo "rust:1-bookworm"
    elif [[ -f "go.mod" ]]; then
        echo "golang:1.23-bookworm"
    elif [[ -f "composer.json" ]]; then
        echo "php:8.4-cli-bookworm"
    elif [[ -f "pubspec.yaml" ]]; then
        echo "dart:stable"
    else
        # Default to Node as it includes npm for Claude Code
        echo "node:22-bookworm"
    fi
}

# Get volume mount for tech-specific dependencies
get_dep_volume() {
    local project_name="$1"

    if [[ -f "package.json" ]]; then
        echo "${project_name}-node-modules:/workspace/node_modules"
    elif [[ -f "requirements.txt" ]] || [[ -f "pyproject.toml" ]]; then
        echo "${project_name}-venv:/workspace/.venv"
    elif [[ -f "Cargo.toml" ]]; then
        echo "${project_name}-target:/workspace/target"
    elif [[ -f "go.mod" ]]; then
        echo "${project_name}-gopath:/go"
    elif [[ -f "composer.json" ]]; then
        echo "${project_name}-vendor:/workspace/vendor"
    else
        echo ""
    fi
}

# Generate Dockerfile for safe mode
generate_dockerfile() {
    local BJN_base_image=$(get_BJN_base_image)

    mkdir -p "$BJARNE_DIR"

    load_prompt_with_subst "dockerfile.template" > "$DOCKERFILE"

    echo -e "  - Generated $DOCKERFILE (base: $BJN_base_image)"
}

#==============================================================================
# GIT/GH DETECTION FUNCTIONS (for task command)
#==============================================================================

# Detect if git is available and we're in a repo
detect_git() {
    if command -v git &>/dev/null && git rev-parse --git-dir &>/dev/null 2>&1; then
        echo "1"
    else
        echo "0"
    fi
}

# Detect if gh CLI is available and authenticated
detect_gh() {
    if command -v gh &>/dev/null && gh auth status &>/dev/null 2>&1; then
        echo "1"
    else
        echo "0"
    fi
}

# Generate task ID from description (uses first line only for slug)
generate_task_id() {
    local description="$1"
    local timestamp=$(date +%s)
    # Use only first non-empty line for slug (handles multi-line markdown)
    local first_line=$(echo "$description" | grep -v '^#' | grep -v '^$' | head -1)
    local slug=$(echo "$first_line" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g' | sed 's/--*/-/g' | cut -c1-30)
    echo "${timestamp}-${slug}"
}

# Run claude with retry logic (safe mode aware)
# Usage: run_claude "prompt" "PHASE_NAME"
run_claude() {
    local user_prompt="$1"
    local phase="${2:-UNKNOWN}"
    local attempt=1
    local exit_code=0
    local claude_log_file=""
    local output=""

    # APPEND verbose output rules to ALL prompts (at end = more prominent)
    local prompt="$user_prompt

$(get_verbose_output_rules)"
    local prompt_size=${#prompt}

    log "INFO" "Starting $phase phase (prompt: $prompt_size bytes)"

    while [[ $attempt -le $MAX_RETRIES ]]; do
        # Generate claude output log file for this attempt
        local timestamp=$(date '+%Y%m%d_%H%M%S')
        claude_log_file="$LOG_DIR/claude_${phase,,}_${timestamp}_attempt${attempt}.log"

        # Write log header
        {
            echo "=============================================================================="
            echo "CLAUDE 输入/输出日志"
            echo "=============================================================================="
            echo "Timestamp: $(date '+%Y-%m-%d %H:%M:%S')"
            echo "Phase: $phase"
            echo "Attempt: $attempt/$MAX_RETRIES"
            echo "Prompt Size: $prompt_size bytes"
            echo ""
            echo "------------------------------------------------------------------------------"
            echo "发送给Claude的 PROMPT (总共 $prompt_size 字节） :"
            echo "------------------------------------------------------------------------------"
            echo "$prompt"
            echo ""
            echo "------------------------------------------------------------------------------"
            echo "CLAUDE 输出:"
            echo "------------------------------------------------------------------------------"
        } > "$claude_log_file"

        # Run claude with tee to output to both screen and file in real-time
        if [[ "$SAFE_MODE" == true ]]; then
            # Run in Docker container (as 'bjarne' user, not root)
            local docker_args="-v $(pwd):/workspace"
            docker_args+=" -v $HOME/.claude/.credentials.json:/home/bjarne/.claude/.credentials.json:ro"

            # Add gh CLI config if available (for PR creation in task mode)
            if [[ -d "$HOME/.config/gh" ]]; then
                docker_args+=" -v $HOME/.config/gh:/home/bjarne/.config/gh:ro"
            fi

            # Add gitconfig if available (for commits)
            if [[ -f "$HOME/.gitconfig" ]]; then
                docker_args+=" -v $HOME/.gitconfig:/home/bjarne/.gitconfig:ro"
            fi

            # Add dependency volume if applicable
            local dep_volume=$(get_dep_volume "$PROJECT_NAME")
            if [[ -n "$dep_volume" ]]; then
                docker_args+=" -v $dep_volume"
            fi

            # Mount temp folder for verbose output logs (same path inside container)
            docker_args+=" -v $BJN_BJARNE_TMP_DIR:$BJN_BJARNE_TMP_DIR"

            # Run with tee for real-time output to both screen and file
            docker run --rm --user "$(id -u):$(id -g)" -e HOME=/home/bjarne \
                $docker_args -w /workspace "$IMAGE_NAME" \
                claude -p --dangerously-skip-permissions "$prompt" 2>&1 | tee -a "$claude_log_file"
            # Get exit code from pipe (use PIPESTATUS)
            exit_code=${PIPESTATUS[0]}
        else
            # Run on host with tee for real-time output
            claude -p --dangerously-skip-permissions "$prompt" 2>&1 | tee -a "$claude_log_file"
            # Get exit code from pipe
            exit_code=${PIPESTATUS[0]}
        fi

        # Write log footer
        {
            echo ""
            echo "------------------------------------------------------------------------------"
            echo "Exit Code: $exit_code"
            echo "=============================================================================="
        } >> "$claude_log_file"

        # Show log file location
        if [[ $exit_code -eq 0 ]]; then
            echo -e "${CYAN}  [日志] $claude_log_file${NC}"
            log "INFO" "$phase 阶段完成->成功 (日志: $claude_log_file)"
            return 0
        fi

        # Check for the specific streaming error
        output=$(tail -100 "$claude_log_file")
        if echo "$output" | grep -q "only prompt commands are supported in streaming mode"; then
            log "ERROR" "$phase: 收到流式模式错误 (第 $attempt 次尝试)"
            echo -e "${YELLOW}  Claude 失败 (第 $attempt/$MAX_RETRIES 次尝试, 退出码: $exit_code)${NC}"
            echo -e "${RED}  错误: '仅支持流式模式下的提示命令'${NC}"
        else
            echo -e "${YELLOW}  Claude 失败 (第 $attempt/$MAX_RETRIES 次尝试, 退出码: $exit_code)${NC}"
        fi

        echo -e "${CYAN}  [日志] $claude_log_file${NC}"

        # Log failure details including the actual prompt
        log_failure "$phase" "$attempt" "$exit_code" "$output" "$prompt_size" "$prompt"

        if [[ $attempt -lt $MAX_RETRIES ]]; then
            echo -e "${YELLOW}  ${RETRY_DELAY}s 后重试...${NC}"
            sleep $RETRY_DELAY
        fi

        ((attempt++))
    done

    echo -e "${RED}  已达最大重试次数 ($MAX_RETRIES 次)${NC}"
    log "ERROR" "$phase 阶段在 $MAX_RETRIES 次尝试后失败"
    echo -e "${YELLOW}  查看详细日志: $LOG_DIR/claude_${phase,,}_*.log${NC}"
    return 1
}

#==============================================================================
# INIT COMMAND - Bootstrap from idea file (works on new or existing projects)
#==============================================================================
if [[ "$1" == "init" ]]; then
    # Parse --safe flag and idea file
    INIT_SAFE_MODE=false
    IDEA_FILE=""

    shift  # Remove "init" from args
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --safe)
                INIT_SAFE_MODE=true
                shift
                ;;
            *)
                IDEA_FILE="$1"
                shift
                ;;
        esac
    done

    if [[ -z "$IDEA_FILE" ]]; then
        echo -e "${RED}用法: bjarne init [--safe] <idea.md>${NC}"
        exit 1
    fi

    if [[ ! -f "$IDEA_FILE" ]]; then
        echo -e "${RED}错误: 未找到 $IDEA_FILE${NC}"
        exit 1
    fi

    # Detect if this is an existing project (has source code files)
    EXISTING_PROJECT="false"
    SRC_FILES=$(find . -maxdepth 3 -type f \( -name "*.cpp" -name "*.h" -name "*.c" -name "*.js" -o -name "*.ts" -o -name "*.py" -o -name "*.php" -o -name "*.go" -o -name "*.rs" -o -name "*.java" -o -name "*.tsx" -o -name "*.jsx" \) 2>/dev/null | grep -v node_modules | grep -v vendor | grep -v __pycache__ | head -20)
    [[ -n "$SRC_FILES" ]] && EXISTING_PROJECT="true"

    if [[ "$EXISTING_PROJECT" == "true" ]]; then
