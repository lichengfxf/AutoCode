#==============================================================================
# TASK 命令 - 隔离的单任务模式
#==============================================================================
if [[ "$1" == "task" ]]; then
    shift  # 从参数中删除 "task"

    # 解析任务命令参数
    TASK_SAFE_MODE=false
    TASK_DESCRIPTION=""
    TASK_NO_PR=false
    TASK_NO_WORKTREE=false
    TASK_MAX_ITERATIONS=25

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --safe)
                TASK_SAFE_MODE=true
                shift
                ;;
            --no-pr)
                TASK_NO_PR=true
                shift
                ;;
            --no-worktree)
                TASK_NO_WORKTREE=true
                shift
                ;;
            -n)
                TASK_MAX_ITERATIONS="$2"
                shift 2
                ;;
            *)
                # 假设它是任务描述（或文件路径）
                TASK_DESCRIPTION="$1"
                shift
                ;;
        esac
    done

    # 自动检测：如果描述是现有文件，则读取它
    if [[ -n "$TASK_DESCRIPTION" ]] && [[ -f "$TASK_DESCRIPTION" ]]; then
        TASK_DESCRIPTION=$(cat "$TASK_DESCRIPTION")
    fi

    if [[ -z "$TASK_DESCRIPTION" ]]; then
        echo -e "${RED}用法: bjarne task [--safe] [--no-pr] [--no-worktree] [-n iterations] <description or file.md>${NC}"
        echo ""
        echo "示例:"
        echo "  bjarne task \"修复登录按钮无响应的问题\""
        echo "  bjarne task bugfix.md                      # 读取文件作为任务"
        echo "  bjarne task --safe \"添加支付集成\""
        echo "  bjarne task --no-worktree \"快速修复\"     # 在当前分支工作 (会影响其他会话)"
        exit 1
    fi

    # 检测 git 和 gh 可用性
    HAS_GIT=$(detect_git)
    HAS_GH=$(detect_gh)

    # 生成任务 ID 和路径（使用绝对路径以在 worktree 切换后保持有效）
    TASK_ID=$(generate_task_id "$TASK_DESCRIPTION")
    TASK_DIR="$BJARNE_PROJECT_ROOT/.bjarne/tasks/$TASK_ID"
    TASK_LOG_DIR="$TASK_DIR/logs"
    TASK_LOG_FILE="$TASK_LOG_DIR/task.log"
    TASK_SUBTASKS="$TASK_DIR/SUBTASKS.md"
    TASK_STATE_FILE="$TASK_DIR/.task"
    TASK_SUMMARY_FILE="$TASK_DIR/summary.md"
    TASK_ORIGINAL_FILE="$TASK_DIR/TASK.md"

    # 创建任务目录结构
    mkdir -p "$TASK_LOG_DIR"
    echo "$TASK_DESCRIPTION" > "$TASK_ORIGINAL_FILE"

    echo -e "${CYAN}Bjarne 任务模式${NC}"
    echo -e "  任务 ID: $TASK_ID"
    echo -e "  任务目录: $TASK_DIR"
    echo -e "  Git 可用: $([ \"$HAS_GIT\" == \"1\" ] && echo \"是\" || echo \"否\")"
    echo -e "  GitHub CLI: $([ \"$HAS_GH\" == \"1\" ] && echo \"是\" || echo \"否\")"

    # 任务专用日志函数
    task_log() {
        local level="$1"
        local msg="$2"
        local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
        echo "[$timestamp] [$level] $msg" >> "$TASK_LOG_FILE"
    }

    task_log "INFO" "=== Task session started ==="
    task_log "INFO" "Task: $TASK_DESCRIPTION"
    task_log "INFO" "Task ID: $TASK_ID"

    # 如果 git 可用，跟踪原始分支
    ORIGINAL_BRANCH=""
    ORIGINAL_DIR=$(pwd)
    WORKTREE_PATH=""
    WORKTREE_BRANCH=""

    if [[ "$HAS_GIT" == "1" ]]; then
        ORIGINAL_BRANCH=$(git rev-parse --abbrev-ref HEAD)
        task_log "INFO" "Starting branch: $ORIGINAL_BRANCH"

        # 除非设置了 --no-worktree 标志，否则创建隔离的 worktree
        if [[ "$TASK_NO_WORKTREE" != true ]]; then
            # 使用 Claude 从任务描述生成分支名（带回退）
            branch_slug=""
            if command -v claude &>/dev/null; then
                branch_slug=$(echo "$TASK_DESCRIPTION" | head -100 | claude -p "为这个任务生成一个简洁的 git 分支名。规则：最多40个字符，小写，仅使用连字符，开头结尾没有连字符，描述工作内容。只输出分支名，不要输出其他内容。" 2>/dev/null | tr -d '[:space:]' | head -c 40)
            fi
            # 如果 Claude 失败或不可用，则回退到简单的 slug
            if [[ -z "$branch_slug" ]]; then
                first_line=$(echo "$TASK_DESCRIPTION" | grep -v '^#' | grep -v '^>' | grep -v '^$' | head -1)
                branch_slug=$(echo "$first_line" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g' | sed 's/--*/-/g' | sed 's/^-//' | sed 's/-$//' | cut -c1-40)
            fi
            WORKTREE_BRANCH="feature/${branch_slug}"
            WORKTREE_PATH="/tmp/bjarne-worktree-$TASK_ID"

            echo -e "${CYAN}正在创建隔离的 worktree...${NC}"
            task_log "INFO" "Creating worktree at $WORKTREE_PATH on branch $WORKTREE_BRANCH"

            # 使用新分支创建 worktree
            if ! git worktree add "$WORKTREE_PATH" -b "$WORKTREE_BRANCH" 2>/dev/null; then
                # 分支可能已存在，尝试不带 -b
                if ! git worktree add "$WORKTREE_PATH" "$WORKTREE_BRANCH" 2>/dev/null; then
                    echo -e "${RED}创建 worktree 失败 - 回退到当前分支${NC}"
                    task_log "WARN" "Worktree creation failed, using current checkout"
                    WORKTREE_PATH=""
                    WORKTREE_BRANCH=""
                fi
            fi

            if [[ -n "$WORKTREE_PATH" ]] && [[ -d "$WORKTREE_PATH" ]]; then
                echo -e "${GREEN}在隔离的 worktree 中工作: $WORKTREE_PATH${NC}"
                echo -e "${GREEN}分支: $WORKTREE_BRANCH${NC}"
                task_log "INFO" "Worktree created successfully"

                # 切换到 worktree 目录
                cd "$WORKTREE_PATH"

                # 更新任务目录路径为绝对路径（以便从 worktree 工作）
                TASK_DIR="$ORIGINAL_DIR/.bjarne/tasks/$TASK_ID"
                TASK_LOG_DIR="$TASK_DIR/logs"
                TASK_LOG_FILE="$TASK_LOG_DIR/task.log"
                TASK_SUBTASKS="$TASK_DIR/SUBTASKS.md"
                TASK_STATE_FILE="$TASK_DIR/.task"
                TASK_SUMMARY_FILE="$TASK_DIR/summary.md"
                TASK_ORIGINAL_FILE="$TASK_DIR/TASK.md"
            fi
        fi
    fi

    # Worktree 的清理函数
    cleanup_worktree() {
        if [[ -n "$WORKTREE_PATH" ]] && [[ -d "$WORKTREE_PATH" ]]; then
            task_log "INFO" "Cleaning up worktree at $WORKTREE_PATH"
            cd "$ORIGINAL_DIR"
            git worktree remove "$WORKTREE_PATH" --force 2>/dev/null || true
        fi
    }

    # 捕获信号以便在退出/中断时清理
    trap cleanup_worktree EXIT

    # 为任务处理安全模式
    if [[ "$TASK_SAFE_MODE" == true ]]; then
        if [[ ! -f "$DOCKERFILE" ]]; then
            echo -e "${CYAN}正在为安全模式生成 Docker 配置...${NC}"
            generate_dockerfile
        fi
        SAFE_MODE=true
        PROJECT_NAME=$(basename "$(pwd)" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9-]/-/g')
        IMAGE_NAME="bjarne-${PROJECT_NAME}"
        build_docker_image "false"
    fi

    echo ""

    # 读取项目上下文（如果可用，只读）
    PROJECT_CONTEXT=""
    if [[ -f "$CONTEXT_FILE" ]]; then
        PROJECT_CONTEXT="## 项目上下文 (来自 CONTEXT.md):
$(cat "$CONTEXT_FILE")

"
    fi

    # 读取规范说明（如果可用，只读）
    SPECS_CONTENT=""
    if [[ -d "$SPECS_DIR" ]]; then
        SPECS_FILES=$(find "$SPECS_DIR" -name "*.md" 2>/dev/null)
        if [[ -n "$SPECS_FILES" ]]; then
            SPECS_CONTENT="## 规范说明 (来自 specs/):
$(cat $SPECS_DIR/*.md 2>/dev/null)

"
        fi
    fi

    # 读取 CLAUDE.md（如果存在）
    CLAUDE_MD_CONTENT=""
    if [[ -f "CLAUDE.md" ]]; then
        CLAUDE_MD_CONTENT="## 项目规则 (来自 CLAUDE.md):
$(cat CLAUDE.md)

"
    fi

    #--------------------------------------------------------------------------
    # 分解阶段 - 将任务分解为子任务
    #--------------------------------------------------------------------------
    echo -e "${BLUE}[分解]${NC} 正在分解任务..."
    task_log "INFO" "[DECOMPOSE] 开始..."

    # 根据 worktree 状态构建 git 工作流指令
    if [[ -n "$WORKTREE_PATH" ]]; then
        GIT_WORKFLOW_INSTRUCTIONS="## Git 工作流
**你正在分支 $WORKTREE_BRANCH 上的隔离 GIT WORKTREE 中工作**
- 不要创建分支子任务 - 你已经在功能分支上了
- 不要运行 git checkout 或 git switch - 保持在当前分支
- 只在执行阶段提交你的更改
- PR 创建在最后进行（由 bjarne 处理）
"
        GIT_EXAMPLE="- [ ] Add onClick handler to login button → Button calls handleLogin function when clicked"
    else
        GIT_WORKFLOW_INSTRUCTIONS="## Git 工作流（如果 git 可用）
1. **第一个子任务应该创建功能分支**（除非任务另有指定）
   - 如果提供了任务描述中的分支名称，请使用它
   - 否则使用描述性名称，如 \`feature/简短描述\` 或 \`fix/简短描述\`
2. 提交在执行阶段进行
3. PR 创建在最后进行（由 bjarne 处理）

如果任务描述包含特定的 git 指令（分支名称、工作流程），请遵循它们。
"
        GIT_EXAMPLE="- [ ] Create feature branch \`feature/login-fix\` → Branch exists and is checked out
- [ ] Add onClick handler to login button → Button calls handleLogin function when clicked"
    fi

    DECOMPOSE_PROMPT_BASE=$(load_prompt "decompose.md")

    DECOMPOSE_FULL_PROMPT="# 要分解的任务:
$TASK_DESCRIPTION

---

$PROJECT_CONTEXT$SPECS_CONTENT$CLAUDE_MD_CONTENT
$GIT_WORKFLOW_INSTRUCTIONS

## 示例
$GIT_EXAMPLE
- [ ] Test login flow → Clicking login button redirects to /dashboard

---

将子任务写入: $TASK_SUBTASKS

$DECOMPOSE_PROMPT_BASE"

    if ! run_claude "$DECOMPOSE_FULL_PROMPT" "DECOMPOSE"; then
        echo -e "${RED}分解阶段失败 - 中止${NC}"
        task_log "ERROR" "[DECOMPOSE] Failed - aborting"
        # EXIT trap 处理 worktree 清理
        exit 1
    fi

    # 验证 SUBTASKS.md 是否已创建
    if [[ ! -f "$TASK_SUBTASKS" ]]; then
        echo -e "${RED}错误: 未创建 SUBTASKS.md${NC}"
        task_log "ERROR" "[DECOMPOSE] No SUBTASKS.md created"
        # EXIT trap 处理 worktree 清理
        exit 1
    fi

    SUBTASK_COUNT=$(grep -c '^\s*- \[ \]' "$TASK_SUBTASKS" 2>/dev/null || echo "0")
    echo -e "${GREEN}已创建 $SUBTASK_COUNT 个子任务${NC}"
    task_log "INFO" "[DECOMPOSE] Created $SUBTASK_COUNT subtasks"
    echo ""

    #--------------------------------------------------------------------------
    # 任务循环 - 运行直到所有子任务完成
    # 使用主提示词并注入任务模式上下文
    #--------------------------------------------------------------------------

    # 如果在 worktree 中，构建 worktree 上下文
    WORKTREE_CONTEXT=""
    if [[ -n "$WORKTREE_PATH" ]]; then
        WORKTREE_CONTEXT="
**GIT WORKTREE ISOLATION:**
- You are working in an ISOLATED worktree at: $WORKTREE_PATH
- Current branch: $WORKTREE_BRANCH
- Do NOT run \`git checkout\` or \`git switch\` - stay on current branch
- Just make commits - bjarne handles branch management
"
    fi

    # 构建任务模式上下文头部（在每个提示词之前注入）
    TASK_MODE_HEADER="## 任务模式 - 隔离修复
$WORKTREE_CONTEXT
**文件映射（读取这些而不是默认值）：**
- TASKS.md → $TASK_SUBTASKS
- .task → $TASK_STATE_FILE

**任务模式规则：**
- 你正在修复现有项目中的特定问题
- 不要删除任何项目源文件 - 只修改需要的内容
- 如果不存在测试基础设施，不要创建新的
- 如果测试存在且此更改自然适合，添加/更新测试
- 如果没有测试，结果验证（grep、curl、文件检查）就足够了

**重要 - 批量处理相关任务：**
不要只选择第一个未选中的任务，你应该：
1. 查看子任务文件中的所有未选中任务
2. 识别相关/耦合任务的逻辑组（例如，一个类中的所有方法、对一个文件的所有更改、所有紧密耦合的更改）
3. 在一轮迭代中一起规划和执行它们
4. 这减少了冗余探索并保持相关更改的原子性

写入 .task 文件格式：
\`\`\`
TASKS: [列出你正在一起处理的相关任务]
EXPECTED_OUTCOMES:
- [任务 1 的预期结果]
- [任务 2 的预期结果]
...其余计划格式...
\`\`\`

**评审阶段**：验证批量任务的所有结果，一起评审所有代码更改。
**修复阶段**：修复批次中所有更改的问题。
**完成时**：在子任务文件中用 [x] 标记所有已完成的任务。

"

    echo -e "${CYAN}启动任务循环 - 最多 $TASK_MAX_ITERATIONS 轮${NC}"
    echo ""

    for i in $(seq 1 $TASK_MAX_ITERATIONS); do
        # 检查剩余的子任务
        if ! grep -q '^\s*- \[ \]' "$TASK_SUBTASKS"; then
            echo -e "${GREEN}所有子任务已完成!${NC}"
            task_log "INFO" "All subtasks complete"
            break
        fi

        REMAINING=$(grep -c '^\s*- \[ \]' "$TASK_SUBTASKS") || REMAINING=0
        echo -e "${YELLOW}=== 任务第 $i/$TASK_MAX_ITERATIONS 轮 (剩余 $REMAINING 个子任务) ===${NC}"
        task_log "INFO" "=== Iteration $i/$TASK_MAX_ITERATIONS ($REMAINING remaining) ==="

        # 构建此迭代的上下文（任务模式头部 + 项目上下文）
        ITER_CONTEXT="$TASK_MODE_HEADER$PROJECT_CONTEXT$SPECS_CONTENT$CLAUDE_MD_CONTENT"

        # 规划（使用主 PLAN_PROMPT 和任务上下文）
        echo -e "${BLUE}[1/4 规划]${NC} 分析子任务..."
        task_log "INFO" "[规划] 开始..."
        if ! run_claude "$ITER_CONTEXT

$PLAN_PROMPT" "TASK_PLAN"; then
            echo -e "${RED}规划阶段失败 - 中止${NC}"
            task_log "ERROR" "[规划] 失败 - 中止"
            break
        fi

        if [[ ! -f "$TASK_STATE_FILE" ]]; then
            echo -e "${RED}规划失败 - 未创建 .task 文件${NC}"
            task_log "ERROR" "[规划] 未创建 .task 文件"
            continue
        fi

        # 记录正在处理的任务
        CURRENT_TASKS=$(grep -E '^TASK:|^TASKS:' "$TASK_STATE_FILE" 2>/dev/null | head -3)
        task_log "INFO" "[规划] 工作中: $CURRENT_TASKS"

        # 执行（使用主 EXECUTE_PROMPT 和任务上下文）
        echo -e "${BLUE}[2/4 执行]${NC} 实现中..."
        task_log "INFO" "[执行] 开始..."
        if ! run_claude "$ITER_CONTEXT

$EXECUTE_PROMPT" "TASK_EXECUTE"; then
            echo -e "${RED}执行阶段失败 - 中止${NC}"
            task_log "ERROR" "[执行] 失败 - 中止"
            break
        fi
        task_log "INFO" "[执行] 完成"

        # 评审（使用主 REVIEW_PROMPT 和任务上下文）
        echo -e "${BLUE}[3/4 评审]${NC} 评审中..."
        task_log "INFO" "[评审] 开始..."
        if ! run_claude "$ITER_CONTEXT

$REVIEW_PROMPT" "TASK_REVIEW"; then
            echo -e "${RED}评审阶段失败 - 中止${NC}"
            task_log "ERROR" "[评审] 失败 - 中止"
            break
        fi
        task_log "INFO" "[评审] 完成"

        # 修复（使用主 FIX_PROMPT 和任务上下文）
        echo -e "${BLUE}[4/4 修复]${NC} 修复中..."
        task_log "INFO" "[修复] 开始..."
        if ! run_claude "$ITER_CONTEXT

$FIX_PROMPT" "TASK_FIX"; then
            echo -e "${RED}修复阶段失败 - 中止${NC}"
            task_log "ERROR" "[修复] 失败 - 中止"
            break
        fi
        task_log "INFO" "[修复] 完成"

        # 记录完成数量
        COMPLETED_NOW=$(grep -c '^\s*- \[x\]' "$TASK_SUBTASKS" 2>/dev/null) || COMPLETED_NOW=0
        task_log "INFO" "第 $i 轮完成 - 目前已完成 $COMPLETED_NOW 个子任务"

        sleep 2
    done

    #--------------------------------------------------------------------------
    # 最终化 - 推送、创建 PR、生成摘要（Claude 处理 git 工作流）
    #--------------------------------------------------------------------------
    echo ""
    echo -e "${CYAN}[FINALIZE]${NC} 正在完成任务..."
    task_log "INFO" "[FINALIZE] 开始..."

    # 构建最终化提示词 - 基于 worktree 模式有所不同
    if [[ -n "$WORKTREE_PATH" ]]; then
        FINALIZE_PROMPT=$(load_prompt_with_subst "finalize-worktree.md" )
    else
        FINALIZE_PROMPT=$(load_prompt "finalize.md")
    fi

    # 如果设置了标志，添加 no-pr 约束
    if [[ "$TASK_NO_PR" == true ]]; then
        FINALIZE_PROMPT+="
- 不要创建 pull request (设置了 --no-pr 标志)"
    fi

    # 添加关于原始分支的上下文
    FINALIZE_PROMPT+="
- 原始分支是: $ORIGINAL_BRANCH
- 子任务文件: $TASK_SUBTASKS

## 子任务状态
$(cat "$TASK_SUBTASKS" 2>/dev/null || echo "未找到子任务文件")
"

    # 运行最终化阶段
    if ! run_claude "$FINALIZE_PROMPT" "FINALIZE"; then
        echo -e "${YELLOW}完成阶段有问题 - 请检查上方输出${NC}"
        task_log "WARN" "[FINALIZE] 有问题"
    else
        task_log "INFO" "[FINALIZE] 完成"
    fi

    # 返回原始分支（安全回退，以防 Claude 没有返回）
    # 如果在 worktree 中，则跳过 - EXIT trap 会处理清理
    if [[ "$HAS_GIT" == "1" ]] && [[ -z "$WORKTREE_PATH" ]]; then
        CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
        if [[ "$CURRENT_BRANCH" != "$ORIGINAL_BRANCH" ]]; then
            git checkout "$ORIGINAL_BRANCH" 2>/dev/null
        fi
    fi

    # 记录最终统计
    FINAL_COMPLETED=$(grep -c '^\s*- \[x\]' "$TASK_SUBTASKS" 2>/dev/null) || FINAL_COMPLETED=0
    FINAL_REMAINING=$(grep -c '^\s*- \[ \]' "$TASK_SUBTASKS" 2>/dev/null) || FINAL_REMAINING=0
    task_log "INFO" "=== 任务完成: 已完成 $FINAL_COMPLETED 个，剩余 $FINAL_REMAINING 个 ==="

    # 输出完成信息
    echo ""
    echo -e "${GREEN}========================================${NC}"
    echo -e "${GREEN}任务完成${NC}"
    echo -e "${GREEN}========================================${NC}"

    # 清理任务状态目录
    echo -e "\n${CYAN}正在清理任务状态...${NC}"
    rm -rf "$TASK_DIR"
    echo -e "${GREEN}完成${NC}"
    exit 0
fi

#==============================================================================
# 主循环 - 规划 → 执行 → 评审 → 修复
#==============================================================================

# 解析主循环参数
MAX_ITERATIONS=25
BATCH_MODE=false
BJN_BATCH_SIZE=5
export BJN_BATCH_SIZE

while [[ $# -gt 0 ]]; do
    case "$1" in
        --batch=*)
            # --batch=N 语法：带自定义大小的批量模式
            BATCH_MODE=true
            BJN_BATCH_SIZE="${1#--batch=}"
            shift
            ;;
        --batch)
            # 仅 --batch：带默认大小的批量模式
            BATCH_MODE=true
            shift
            ;;
        -b=*)
            # -b=N 语法：带自定义大小的批量模式
            BATCH_MODE=true
            BJN_BATCH_SIZE="${1#-b=}"
            shift
            ;;
        -b[0-9]*)
            # -bN 语法（无空格）：带自定义大小的批量模式
            BATCH_MODE=true
            BJN_BATCH_SIZE="${1#-b}"
            shift
            ;;
        -b)
            # 仅 -b：带默认大小的批量模式
            BATCH_MODE=true
            shift
            ;;
        [0-9]*)
            MAX_ITERATIONS="$1"
            shift
            ;;
        *)
            echo -e "${RED}未知选项: $1${NC}"
            echo "用法: bjarne [options] [iterations]"
            echo "选项:"
            echo "  --batch       启用批量模式 (最多 5 个相关任务)"
            echo "  --batch=N     启用批量模式并指定数量"
            echo "  -b, -bN       --batch 和 --batch=N 的简写"
            exit 1
            ;;
    esac
done

# 检查必需文件
if [[ ! -f "$TASK_FILE" ]]; then
    echo -e "${RED}错误: 未找到 $TASK_FILE${NC}"
    echo -e "请先运行 'bjarne init' (需要 idea.md 文件)"
    exit 1
fi

if [[ ! -f "$CONTEXT_FILE" ]]; then
    echo -e "${YELLOW}警告: 未找到 $CONTEXT_FILE${NC}"
fi

# 检测并设置安全模式（如果适用）
detect_safe_mode
if [[ "$SAFE_MODE" == true ]]; then
    echo -e "${CYAN}检测到安全模式 (找到 .bjarne/Dockerfile)${NC}"
    build_docker_image "false"
    echo ""
fi

# 记录会话开始
log "INFO" "=== Bjarne 会话开始 ==="
log "INFO" "最大迭代次数: $MAX_ITERATIONS, 安全模式: $SAFE_MODE, 批量模式: $BATCH_MODE (大小: $BJN_BATCH_SIZE)"
log "INFO" "工作目录: $(pwd)"

echo -e "${CYAN}Bjarne 启动中 - 最多 $MAX_ITERATIONS 轮迭代${NC}"
if [[ "$BATCH_MODE" == true ]]; then
    echo -e "${CYAN}批量模式: 每轮最多处理 $BJN_BATCH_SIZE 个相关任务${NC}"
fi
echo -e "${CYAN}循环: 规划 → 执行 → 评审 → 修复${NC}"
echo -e "${CYAN}日志: $LOG_FILE${NC}"
echo ""

for i in $(seq 1 $MAX_ITERATIONS); do
    # 检查剩余任务
    if ! grep -q '^\s*- \[ \]' "$TASK_FILE"; then
        echo -e "${GREEN}所有任务已完成!${NC}"
        rm -f "$TASK_STATE"
        exit 0
    fi

    REMAINING=$(grep -c '^\s*- \[ \]' "$TASK_FILE" || echo "0")
    echo -e "${YELLOW}=== 第 $i/$MAX_ITERATIONS 轮 (剩余 $REMAINING 个任务) ===${NC}"

    # 根据批量模式选择提示词
    if [[ "$BATCH_MODE" == true ]]; then
        ACTIVE_PLAN_PROMPT=$(load_prompt_with_subst "batch-plan.md.template" )
        ACTIVE_EXECUTE_PROMPT=$(load_prompt "batch-execute.md")
        ACTIVE_REVIEW_PROMPT=$(load_prompt "batch-review.md")
        ACTIVE_FIX_PROMPT=$(load_prompt "batch-fix.md")
    else
        ACTIVE_PLAN_PROMPT="$PLAN_PROMPT"
        ACTIVE_EXECUTE_PROMPT="$EXECUTE_PROMPT"
        ACTIVE_REVIEW_PROMPT="$REVIEW_PROMPT"
        ACTIVE_FIX_PROMPT="$FIX_PROMPT"
    fi

    # PLAN
    echo -e "${BLUE}[1/4 规划]${NC} 分析中..."
    if ! run_claude "$ACTIVE_PLAN_PROMPT" "PLAN"; then
        echo -e "${RED}规划阶段在 $MAX_RETRIES 次重试后失败 - 中止${NC}"
        exit 1
    fi

    if [[ ! -f "$TASK_STATE" ]]; then
        echo -e "${RED}规划失败 - 未找到 .task 文件${NC}"
        continue
    fi

    # EXECUTE
    echo -e "${BLUE}[2/4 执行]${NC} 实现中..."
    if ! run_claude "$ACTIVE_EXECUTE_PROMPT" "EXECUTE"; then
        echo -e "${RED}执行阶段在 $MAX_RETRIES 次重试后失败 - 中止${NC}"
        exit 1
    fi

    # REVIEW
    echo -e "${BLUE}[3/4 评审]${NC} 评审中..."
    if ! run_claude "$ACTIVE_REVIEW_PROMPT" "REVIEW"; then
        echo -e "${RED}评审阶段在 $MAX_RETRIES 次重试后失败 - 中止${NC}"
        exit 1
    fi

    # FIX
    echo -e "${BLUE}[4/4 修复]${NC} 修复中..."
    if ! run_claude "$ACTIVE_FIX_PROMPT" "FIX"; then
        echo -e "${RED}修复阶段在 $MAX_RETRIES 次重试后失败 - 中止${NC}"
        exit 1
    fi

    sleep 2
done

echo -e "${YELLOW}已达到最大迭代次数${NC}"
